            ],
            "application/javascript": [
              "\n",
              "    async function download(id, filename, size) {\n",
              "      if (!google.colab.kernel.accessAllowed) {\n",
              "        return;\n",
              "      }\n",
              "      const div = document.createElement('div');\n",
              "      const label = document.createElement('label');\n",
              "      label.textContent = `Downloading \"${filename}\": `;\n",
              "      div.appendChild(label);\n",
              "      const progress = document.createElement('progress');\n",
              "      progress.max = size;\n",
              "      div.appendChild(progress);\n",
              "      document.body.appendChild(div);\n",
              "\n",
              "      const buffers = [];\n",
              "      let downloaded = 0;\n",
              "\n",
              "      const channel = await google.colab.kernel.comms.open(id);\n",
              "      // Send a message to notify the kernel that we're ready.\n",
              "      channel.send({})\n",
              "\n",
              "      for await (const message of channel.messages) {\n",
              "        // Send a message to notify the kernel that we're ready.\n",
              "        channel.send({})\n",
              "        if (message.buffers) {\n",
              "          for (const buffer of message.buffers) {\n",
              "            buffers.push(buffer);\n",
              "            downloaded += buffer.byteLength;\n",
              "            progress.value = downloaded;\n",
              "          }\n",
              "        }\n",
              "      }\n",
              "      const blob = new Blob(buffers, {type: 'application/binary'});\n",
              "      const a = document.createElement('a');\n",
              "      a.href = window.URL.createObjectURL(blob);\n",
              "      a.download = filename;\n",
              "      div.appendChild(a);\n",
              "      a.click();\n",
              "      div.remove();\n",
              "    }\n",
              "  "
            ]
          },
          "metadata": {}
        },
        {
          "output_type": "display_data",
          "data": {
            "text/plain": [
              "<IPython.core.display.Javascript object>"
            ],
            "application/javascript": [
              "download(\"download_31ae2352-974f-49c7-9f24-a883da3e8071\", \"Relatorio_Analise_Exploratoria.xlsx\", 10310)"
            ]
          },
          "metadata": {}
        },
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "\n",
            "ANÁLISE FINALIZADA!\n",
            "Os dados originais não foram alterados.\n"
          ]
        }
      ],
      "source": [
        "\n",
        "# ============================================================\n",
        "# ANÁLISE EXPLORATÓRIA DE DADOS — SALES TRANSACTIONS 2022–2025\n",
        "# Baseado na apostila de Pré-processamento e Análise de Dados\n",
        "# Execução: Google Colab\n",
        "# ============================================================\n",
        "\n",
        "# ETAPA 1 — IMPORTAR BIBLIOTECAS\n",
        "# Bibliotecas são ferramentas prontas para cálculos e gráficos.\n",
        "\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from IPython.display import display\n",
        "from google.colab import drive, files\n",
        "\n",
        "pd.set_option(\"display.max_columns\", 50)\n",
        "pd.set_option(\"display.max_rows\", 100)\n",
        "\n",
        "print(\"Bibliotecas carregadas com sucesso!\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 2 — CONECTAR O GOOGLE DRIVE\n",
        "# ============================================================\n",
        "\n",
        "drive.mount(\"/content/drive\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 3 — INFORMAR O CAMINHO DO ARQUIVO\n",
        "#\n",
        "# ATENÇÃO: ALTERE SOMENTE A LINHA ABAIXO.\n",
        "# Cole entre as aspas o caminho copiado do seu Drive.\n",
        "# ============================================================\n",
        "\n",
        "CAMINHO_ARQUIVO = \"/content/drive/MyDrive/Banco de Dados 1/Sales_transactions_2022_2025.xlsx\"\n",
        "# ============================================================\n",
        "# FIM DA PARTE QUE VOCÊ PRECISA ALTERAR\n",
        "# ============================================================\n",
        "\n",
        "\n",
        "# ETAPA 4 — CARREGAR A PLANILHA\n",
        "\n",
        "df_original = pd.read_excel(CAMINHO_ARQUIVO)\n",
        "\n",
        "# Criamos uma cópia para preservar os dados originais.\n",
        "df = df_original.copy()\n",
        "\n",
        "print(\"\\nARQUIVO CARREGADO COM SUCESSO!\")\n",
        "print(\"Quantidade de linhas:\", df.shape[0])\n",
        "print(\"Quantidade de variáveis:\", df.shape[1])\n",
        "\n",
        "print(\"\\nPrimeiras cinco observações:\")\n",
        "display(df.head())\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 5 — IDENTIFICAR E CLASSIFICAR AS VARIÁVEIS\n",
        "# ============================================================\n",
        "\n",
        "# A classificação abaixo leva em conta o significado\n",
        "# das variáveis, não apenas como aparecem no Excel.\n",
        "\n",
        "tipos = {\n",
        "    \"Transaction_ID\": \"Identificador\",\n",
        "    \"Order_ID\": \"Identificador\",\n",
        "    \"Customer_ID\": \"Identificador\",\n",
        "    \"Customer_Name\": \"Identificador\",\n",
        "    \"Customer_Age\": \"Quantitativa\",\n",
        "    \"Customer_Gender\": \"Categórica\",\n",
        "    \"Customer_Segment\": \"Categórica\",\n",
        "    \"Order_Date\": \"Data\",\n",
        "    \"Order_Time\": \"Hora\",\n",
        "    \"Sales_Channel\": \"Categórica\",\n",
        "    \"Store_ID\": \"Identificador\",\n",
        "    \"Store_Name\": \"Categórica\",\n",
        "    \"Country\": \"Categórica\",\n",
        "    \"Region\": \"Categórica\",\n",
        "    \"City\": \"Categórica\",\n",
        "    \"Product_ID\": \"Identificador\",\n",
        "    \"Product_Name\": \"Categórica\",\n",
        "    \"Product_Category\": \"Categórica\",\n",
        "    \"Product_Subcategory\": \"Categórica\",\n",
        "    \"Quantity\": \"Quantitativa\",\n",
        "    \"Unit_Price\": \"Quantitativa\",\n",
        "    \"Discount_Percentage\": \"Quantitativa\",\n",
        "    \"Sales_Amount\": \"Quantitativa\",\n",
        "    \"Cost_Amount\": \"Quantitativa\",\n",
        "    \"Profit\": \"Quantitativa\",\n",
        "    \"Payment_Method\": \"Categórica\",\n",
        "    \"Order_Status\": \"Categórica\",\n",
        "    \"Shipping_Method\": \"Categórica\",\n",
        "    \"Delivery_Days\": \"Quantitativa\",\n",
        "    \"Return_Flag\": \"Categórica\",\n",
        "    \"Return_Reason\": \"Categórica\",\n",
        "    \"Sales_Representative\": \"Categórica\",\n",
        "    \"Promotion_Code\": \"Categórica\",\n",
        "    \"Customer_Rating\": \"Quantitativa\",\n",
        "    \"Inventory_Level\": \"Quantitativa\",\n",
        "    \"Order_Year\": \"Ano\"\n",
        "}\n",
        "\n",
        "# Dicionário com o tipo de cada coluna.\n",
        "dicionario = pd.DataFrame({\n",
        "    \"Variável\": df.columns,\n",
        "    \"Tipo\": [tipos.get(c, \"Verificar\") for c in df.columns]\n",
        "})\n",
        "\n",
        "print(\"\\nCLASSIFICAÇÃO DAS VARIÁVEIS:\")\n",
        "display(dicionario)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 6 — PREPARAÇÃO PARA A ANÁLISE\n",
        "# ============================================================\n",
        "\n",
        "# Células que contêm somente espaços serão consideradas\n",
        "# ausentes. Não substituímos os valores ausentes.\n",
        "\n",
        "df = df.replace(r\"^\\s*$\", np.nan, regex=True)\n",
        "\n",
        "numericas = [\n",
        "    c for c in df.columns\n",
        "    if tipos.get(c) in [\"Quantitativa\", \"Ano\"]\n",
        "]\n",
        "\n",
        "for coluna in numericas:\n",
        "    df[coluna] = pd.to_numeric(\n",
        "        df[coluna], errors=\"coerce\"\n",
        "    )\n",
        "\n",
        "if \"Order_Date\" in df.columns:\n",
        "    df[\"Order_Date\"] = pd.to_datetime(\n",
        "        df[\"Order_Date\"], errors=\"coerce\"\n",
        "    )\n",
        "\n",
        "print(\"\\nTipos de dados reconhecidos:\")\n",
        "display(df.dtypes.to_frame(\"Tipo no Python\"))\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 7 — IDENTIFICAR MISSING VALUES\n",
        "# ============================================================\n",
        "\n",
        "print(\"\\nANÁLISE DE VALORES AUSENTES\")\n",
        "\n",
        "missing = pd.DataFrame({\n",
        "    \"Variável\": df.columns,\n",
        "    \"Ausentes\": df.isna().sum().values,\n",
        "    \"Percentual (%)\": (\n",
        "        df.isna().mean().values * 100\n",
        "    ).round(2)\n",
        "})\n",
        "\n",
        "display(missing)\n",
        "\n",
        "print(\"\\nTotal de células ausentes:\",\n",
        "      int(df.isna().sum().sum()))\n",
        "\n",
        "# Gráfico dos valores ausentes\n",
        "\n",
        "ausentes_grafico = missing[\n",
        "    missing[\"Ausentes\"] > 0\n",
        "]\n",
        "\n",
        "if not ausentes_grafico.empty:\n",
        "    plt.figure(figsize=(12, 6))\n",
        "\n",
        "    plt.barh(\n",
        "        ausentes_grafico[\"Variável\"],\n",
        "        ausentes_grafico[\"Percentual (%)\"]\n",
        "    )\n",
        "\n",
        "    plt.title(\"Percentual de valores ausentes\")\n",
        "    plt.xlabel(\"Percentual (%)\")\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "else:\n",
        "    print(\"Nenhuma ausência identificada.\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 8 — FUNÇÃO PARA ANALISAR CADA VARIÁVEL\n",
        "# ============================================================\n",
        "\n",
        "def analisar_variavel(coluna, graficos=True):\n",
        "\n",
        "    if coluna not in df.columns:\n",
        "        print(\"Variável não encontrada:\", coluna)\n",
        "        return\n",
        "\n",
        "    serie = df[coluna]\n",
        "    tipo = tipos.get(coluna, \"Verificar\")\n",
        "\n",
        "    print(\"\\n\" + \"=\" * 65)\n",
        "    print(\"VARIÁVEL:\", coluna)\n",
        "    print(\"TIPO:\", tipo)\n",
        "    print(\"=\" * 65)\n",
        "\n",
        "    # Informações gerais\n",
        "\n",
        "    print(\"Total de observações:\", len(serie))\n",
        "    print(\"Valores válidos:\", serie.notna().sum())\n",
        "    print(\"Valores ausentes:\", serie.isna().sum())\n",
        "    print(\"Percentual ausente:\",\n",
        "          round(serie.isna().mean() * 100, 2), \"%\")\n",
        "    print(\"Valores distintos:\", serie.nunique())\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # ANÁLISE DE VARIÁVEIS QUANTITATIVAS\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    if tipo in [\"Quantitativa\", \"Ano\"]:\n",
        "\n",
        "        dados = pd.to_numeric(\n",
        "            serie, errors=\"coerce\"\n",
        "        ).dropna()\n",
        "\n",
        "        if dados.empty:\n",
        "            print(\"Não há valores numéricos válidos.\")\n",
        "            return\n",
        "\n",
        "        print(\"\\nESTATÍSTICA DESCRITIVA\")\n",
        "\n",
        "        estatisticas = pd.DataFrame({\n",
        "            \"Medida\": [\n",
        "                \"Contagem\",\n",
        "                \"Média\",\n",
        "                \"Mediana\",\n",
        "                \"Desvio padrão\",\n",
        "                \"Variância\",\n",
        "                \"Mínimo\",\n",
        "                \"Primeiro quartil (Q1)\",\n",
        "                \"Terceiro quartil (Q3)\",\n",
        "                \"Máximo\",\n",
        "                \"Assimetria\",\n",
        "                \"Curtose\",\n",
        "                \"Quantidade de zeros\"\n",
        "            ],\n",
        "            \"Resultado\": [\n",
        "                dados.count(),\n",
        "                dados.mean(),\n",
        "                dados.median(),\n",
        "                dados.std(),\n",
        "                dados.var(),\n",
        "                dados.min(),\n",
        "                dados.quantile(0.25),\n",
        "                dados.quantile(0.75),\n",
        "                dados.max(),\n",
        "                dados.skew(),\n",
        "                dados.kurt(),\n",
        "                (dados == 0).sum()\n",
        "            ]\n",
        "        })\n",
        "\n",
        "        display(estatisticas)\n",
        "\n",
        "        # ----------------------------------------------------\n",
        "        # DETECÇÃO DE OUTLIERS — MÉTODO IQR\n",
        "        # ----------------------------------------------------\n",
        "\n",
        "        q1 = dados.quantile(0.25)\n",
        "        q3 = dados.quantile(0.75)\n",
        "\n",
        "        iqr = q3 - q1\n",
        "\n",
        "        limite_inferior = q1 - 1.5 * iqr\n",
        "        limite_superior = q3 + 1.5 * iqr\n",
        "\n",
        "        outliers = dados[\n",
        "            (dados < limite_inferior) |\n",
        "            (dados > limite_superior)\n",
        "        ]\n",
        "\n",
        "        print(\"\\nANÁLISE DE OUTLIERS\")\n",
        "\n",
        "        print(\"IQR:\", round(iqr, 3))\n",
        "        print(\"Limite inferior:\",\n",
        "              round(limite_inferior, 3))\n",
        "        print(\"Limite superior:\",\n",
        "              round(limite_superior, 3))\n",
        "\n",
        "        print(\"Possíveis outliers:\", len(outliers))\n",
        "\n",
        "        print(\"Percentual de outliers:\",\n",
        "              round(\n",
        "                  len(outliers) / len(dados) * 100, 2\n",
        "              ), \"%\")\n",
        "\n",
        "        # Não removemos outliers automaticamente.\n",
        "\n",
        "        if graficos:\n",
        "\n",
        "            # HISTOGRAMA\n",
        "\n",
        "            plt.figure(figsize=(10, 4))\n",
        "            plt.hist(\n",
        "                dados,\n",
        "                bins=30,\n",
        "                edgecolor=\"black\"\n",
        "            )\n",
        "\n",
        "            plt.axvline(\n",
        "                dados.mean(),\n",
        "                color=\"red\",\n",
        "                linestyle=\"--\",\n",
        "                label=\"Média\"\n",
        "            )\n",
        "\n",
        "            plt.axvline(\n",
        "                dados.median(),\n",
        "                color=\"green\",\n",
        "                linestyle=\"--\",\n",
        "                label=\"Mediana\"\n",
        "            )\n",
        "\n",
        "            plt.title(\"Histograma — \" + coluna)\n",
        "            plt.xlabel(coluna)\n",
        "            plt.ylabel(\"Frequência\")\n",
        "            plt.legend()\n",
        "            plt.tight_layout()\n",
        "            plt.show()\n",
        "\n",
        "            # BOXPLOT\n",
        "\n",
        "            plt.figure(figsize=(10, 3))\n",
        "\n",
        "            plt.boxplot(\n",
        "                dados,\n",
        "                vert=False\n",
        "            )\n",
        "\n",
        "            plt.title(\"Boxplot — \" + coluna)\n",
        "            plt.xlabel(coluna)\n",
        "            plt.tight_layout()\n",
        "            plt.show()\n",
        "\n",
        "        return\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # ANÁLISE DE VARIÁVEIS DE DATA\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    if tipo == \"Data\":\n",
        "\n",
        "        datas = pd.to_datetime(\n",
        "            serie, errors=\"coerce\"\n",
        "        ).dropna()\n",
        "\n",
        "        if datas.empty:\n",
        "            print(\"Não há datas válidas.\")\n",
        "            return\n",
        "\n",
        "        print(\"\\nPrimeira data:\", datas.min())\n",
        "        print(\"Última data:\", datas.max())\n",
        "\n",
        "        frequencia_mensal = (\n",
        "            datas.dt.to_period(\"M\")\n",
        "            .value_counts()\n",
        "            .sort_index()\n",
        "        )\n",
        "\n",
        "        display(frequencia_mensal.to_frame(\"Quantidade\"))\n",
        "\n",
        "        if graficos:\n",
        "            frequencia_mensal.plot(\n",
        "                kind=\"line\",\n",
        "                figsize=(12, 4),\n",
        "                marker=\"o\"\n",
        "            )\n",
        "\n",
        "            plt.title(\"Registros por mês\")\n",
        "            plt.xlabel(\"Mês\")\n",
        "            plt.ylabel(\"Frequência\")\n",
        "            plt.tight_layout()\n",
        "            plt.show()\n",
        "\n",
        "        return\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # ANÁLISE DE HORÁRIOS\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    if tipo == \"Hora\":\n",
        "\n",
        "        horarios = pd.to_datetime(\n",
        "            serie.dropna().astype(str),\n",
        "            format=\"%H:%M:%S\",\n",
        "            errors=\"coerce\"\n",
        "        )\n",
        "\n",
        "        horas = horarios.dt.hour\n",
        "\n",
        "        frequencias = (\n",
        "            horas.value_counts().sort_index()\n",
        "        )\n",
        "\n",
        "        display(frequencias.to_frame(\"Frequência\"))\n",
        "\n",
        "        print(\"Horários não reconhecidos:\",\n",
        "              int(horas.isna().sum()))\n",
        "\n",
        "        if graficos and not frequencias.empty:\n",
        "            frequencias.plot(\n",
        "                kind=\"bar\",\n",
        "                figsize=(10, 4)\n",
        "            )\n",
        "\n",
        "            plt.title(\"Distribuição por hora\")\n",
        "            plt.xlabel(\"Hora\")\n",
        "            plt.ylabel(\"Frequência\")\n",
        "            plt.tight_layout()\n",
        "            plt.show()\n",
        "\n",
        "        return\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # ANÁLISE DE IDENTIFICADORES E CATEGORIAS\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    print(\"\\nDISTRIBUIÇÃO DE FREQUÊNCIAS\")\n",
        "\n",
        "    frequencia = serie.value_counts(\n",
        "        dropna=False\n",
        "    )\n",
        "\n",
        "    percentual = (\n",
        "        frequencia / len(serie) * 100\n",
        "    ).round(2)\n",
        "\n",
        "    tabela = pd.DataFrame({\n",
        "        \"Frequência absoluta\": frequencia,\n",
        "        \"Frequência relativa (%)\": percentual\n",
        "    })\n",
        "\n",
        "    display(tabela.head(20))\n",
        "\n",
        "    if tipo == \"Identificador\":\n",
        "        print(\"\\nIdentificadores repetidos:\",\n",
        "              serie.dropna().duplicated().sum())\n",
        "\n",
        "        print(\n",
        "            \"Repetições podem ser legítimas, \"\n",
        "            \"dependendo da unidade de análise.\"\n",
        "        )\n",
        "\n",
        "    elif graficos and not tabela.empty:\n",
        "\n",
        "        plt.figure(figsize=(11, 5))\n",
        "\n",
        "        frequencia.head(15).iloc[::-1].plot(\n",
        "            kind=\"barh\"\n",
        "        )\n",
        "\n",
        "        plt.title(\"Frequências — \" + coluna)\n",
        "        plt.xlabel(\"Quantidade\")\n",
        "        plt.tight_layout()\n",
        "        plt.show()\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 9 — ANALISAR TODAS AS VARIÁVEIS\n",
        "# ============================================================\n",
        "\n",
        "# True: mostra gráficos.\n",
        "# False: mostra resultados sem gráficos.\n",
        "\n",
        "MOSTRAR_GRAFICOS = True\n",
        "\n",
        "for numero, coluna in enumerate(df.columns, 1):\n",
        "\n",
        "    print(\"\\n\")\n",
        "    print(\"ANÁLISE\", numero, \"DE\", len(df.columns))\n",
        "\n",
        "    analisar_variavel(\n",
        "        coluna,\n",
        "        graficos=MOSTRAR_GRAFICOS\n",
        "    )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 10 — ANALISAR UMA VARIÁVEL ESPECÍFICA\n",
        "# ============================================================\n",
        "\n",
        "# Você pode trocar \"Profit\" por qualquer coluna.\n",
        "# Exemplos:\n",
        "# \"Customer_Age\"\n",
        "# \"Sales_Amount\"\n",
        "# \"Discount_Percentage\"\n",
        "# \"Quantity\"\n",
        "\n",
        "VARIAVEL_ESCOLHIDA = \"Profit\"\n",
        "\n",
        "analisar_variavel(\n",
        "    VARIAVEL_ESCOLHIDA,\n",
        "    graficos=True\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 11 — VERIFICAR CONSISTÊNCIA DOS DADOS\n",
        "# ============================================================\n",
        "\n",
        "alertas = []\n",
        "\n",
        "def registrar_alerta(nome, condicao):\n",
        "\n",
        "    alertas.append({\n",
        "        \"Verificação\": nome,\n",
        "        \"Ocorrências\": int(\n",
        "            condicao.fillna(False).sum()\n",
        "        )\n",
        "    })\n",
        "\n",
        "\n",
        "# Verificação de valores negativos\n",
        "\n",
        "colunas_verificar = [\n",
        "    \"Customer_Age\",\n",
        "    \"Quantity\",\n",
        "    \"Unit_Price\",\n",
        "    \"Sales_Amount\",\n",
        "    \"Cost_Amount\",\n",
        "    \"Delivery_Days\",\n",
        "    \"Inventory_Level\"\n",
        "]\n",
        "\n",
        "for coluna in colunas_verificar:\n",
        "\n",
        "    if coluna in df.columns:\n",
        "\n",
        "        registrar_alerta(\n",
        "            coluna + \" negativo\",\n",
        "            df[coluna] < 0\n",
        "        )\n",
        "\n",
        "\n",
        "# Idades potencialmente inconsistentes\n",
        "\n",
        "if \"Customer_Age\" in df.columns:\n",
        "\n",
        "    registrar_alerta(\n",
        "        \"Idade fora de 0 a 120\",\n",
        "        (df[\"Customer_Age\"] < 0) |\n",
        "        (df[\"Customer_Age\"] > 120)\n",
        "    )\n",
        "\n",
        "\n",
        "# Descontos fora da faixa esperada.\n",
        "# Pressupõe desconto registrado entre 0 e 100.\n",
        "\n",
        "if \"Discount_Percentage\" in df.columns:\n",
        "\n",
        "    registrar_alerta(\n",
        "        \"Desconto fora de 0 a 100\",\n",
        "        (df[\"Discount_Percentage\"] < 0) |\n",
        "        (df[\"Discount_Percentage\"] > 100)\n",
        "    )\n",
        "\n",
        "\n",
        "# Verificar igualdade contábil:\n",
        "# Lucro = Vendas - Custos\n",
        "# A regra deve ser confirmada no negócio.\n",
        "\n",
        "colunas_lucro = [\n",
        "    \"Profit\", \"Sales_Amount\", \"Cost_Amount\"\n",
        "]\n",
        "\n",
        "if all(c in df.columns for c in colunas_lucro):\n",
        "\n",
        "    diferenca = (\n",
        "        df[\"Sales_Amount\"] -\n",
        "        df[\"Cost_Amount\"] -\n",
        "        df[\"Profit\"]\n",
        "    ).abs()\n",
        "\n",
        "    registrar_alerta(\n",
        "        \"Diferença na relação vendas-custo-lucro\",\n",
        "        diferenca > 0.02\n",
        "    )\n",
        "\n",
        "\n",
        "# Consistência entre data e ano do pedido\n",
        "\n",
        "if {\"Order_Date\", \"Order_Year\"}.issubset(df.columns):\n",
        "\n",
        "    ano_data = df[\"Order_Date\"].dt.year\n",
        "\n",
        "    divergencia = (\n",
        "        ano_data.ne(df[\"Order_Year\"]) &\n",
        "        ano_data.notna() &\n",
        "        df[\"Order_Year\"].notna()\n",
        "    )\n",
        "\n",
        "    registrar_alerta(\n",
        "        \"Ano divergente da data do pedido\",\n",
        "        divergencia\n",
        "    )\n",
        "\n",
        "\n",
        "alertas_df = pd.DataFrame(alertas)\n",
        "\n",
        "print(\"\\nRELATÓRIO DE CONSISTÊNCIA\")\n",
        "display(alertas_df)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 12 — RESUMO DA QUALIDADE DE CADA VARIÁVEL\n",
        "# ============================================================\n",
        "\n",
        "resumo = []\n",
        "\n",
        "for coluna in df.columns:\n",
        "\n",
        "    serie = df[coluna]\n",
        "\n",
        "    item = {\n",
        "        \"Variável\": coluna,\n",
        "        \"Tipo\": tipos.get(coluna, \"Verificar\"),\n",
        "        \"Observações\": len(serie),\n",
        "        \"Ausentes\": int(serie.isna().sum()),\n",
        "        \"Ausentes (%)\": round(\n",
        "            serie.isna().mean() * 100, 2\n",
        "        ),\n",
        "        \"Valores distintos\": serie.nunique()\n",
        "    }\n",
        "\n",
        "    if coluna in numericas:\n",
        "\n",
        "        dados = serie.dropna()\n",
        "\n",
        "        if not dados.empty:\n",
        "\n",
        "            q1 = dados.quantile(0.25)\n",
        "            q3 = dados.quantile(0.75)\n",
        "\n",
        "            iqr = q3 - q1\n",
        "\n",
        "            li = q1 - 1.5 * iqr\n",
        "            ls = q3 + 1.5 * iqr\n",
        "\n",
        "            item[\"Outliers IQR\"] = int(\n",
        "                ((dados < li) | (dados > ls)).sum()\n",
        "            )\n",
        "\n",
        "    resumo.append(item)\n",
        "\n",
        "resumo_df = pd.DataFrame(resumo)\n",
        "\n",
        "print(\"\\nRESUMO COMPLETO DAS VARIÁVEIS\")\n",
        "display(resumo_df)\n",
        "\n",
        "print(\n",
        "    \"\\nLinhas completamente duplicadas:\",\n",
        "    int(df.duplicated().sum())\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 13 — ANÁLISE DE DEVOLUÇÕES\n",
        "# ============================================================\n",
        "\n",
        "if {\"Return_Flag\", \"Return_Reason\"}.issubset(df.columns):\n",
        "\n",
        "    print(\"\\nDEVOLUÇÕES E MOTIVOS AUSENTES\")\n",
        "\n",
        "    tabela_devolucao = pd.crosstab(\n",
        "        df[\"Return_Flag\"].fillna(\"Ausente\"),\n",
        "        df[\"Return_Reason\"].isna().map({\n",
        "            True: \"Motivo ausente\",\n",
        "            False: \"Motivo informado\"\n",
        "        }),\n",
        "        margins=True\n",
        "    )\n",
        "\n",
        "    display(tabela_devolucao)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 14 — EXPORTAR RELATÓRIO PARA EXCEL\n",
        "# ============================================================\n",
        "\n",
        "nome_saida = \"Relatorio_Analise_Exploratoria.xlsx\"\n",
        "\n",
        "with pd.ExcelWriter(\n",
        "    nome_saida,\n",
        "    engine=\"openpyxl\"\n",
        ") as writer:\n",
        "\n",
        "    dicionario.to_excel(\n",
        "        writer,\n",
        "        sheet_name=\"Dicionario\",\n",
        "        index=False\n",
        "    )\n",
        "\n",
        "    missing.to_excel(\n",
        "        writer,\n",
        "        sheet_name=\"Missing_Values\",\n",
        "        index=False\n",
        "    )\n",
        "\n",
        "    resumo_df.to_excel(\n",
        "        writer,\n",
        "        sheet_name=\"Resumo_Variaveis\",\n",
        "        index=False\n",
        "    )\n",
        "\n",
        "    alertas_df.to_excel(\n",
        "        writer,\n",
        "        sheet_name=\"Consistencia\",\n",
        "        index=False\n",
        "    )\n",
        "\n",
        "    if {\"Return_Flag\", \"Return_Reason\"}.issubset(\n",
        "        df.columns\n",
        "    ):\n",
        "        tabela_devolucao.to_excel(\n",
        "            writer,\n",
        "            sheet_name=\"Devolucoes\"\n",
        "        )\n",
        "\n",
        "print(\"\\nRELATÓRIO GERADO COM SUCESSO!\")\n",
        "print(\"Arquivo:\", nome_saida)\n",
        "\n",
        "files.download(nome_saida)\n",
        "\n",
        "print(\"\\nANÁLISE FINALIZADA!\")\n",
        "print(\"Os dados originais não foram alterados.\")\n"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "# ============================================================\n",
        "# MACHINE LEARNING - PREVISÃO DO VALOR DAS VENDAS\n",
        "# Dataset: Sales_transactions_2022_2025\n",
        "#\n",
        "# Algoritmos:\n",
        "# 1. Regressão Linear\n",
        "# 2. Lasso - Regularização L1\n",
        "# 3. Ridge - Regularização L2\n",
        "# 4. Elastic Net - Regularização L1 + L2\n",
        "#\n",
        "# Método:\n",
        "# Pipeline + GridSearchCV + K-Fold (5 divisões)\n",
        "#\n",
        "# IMPORTANTE:\n",
        "# O arquivo Excel original não será alterado.\n",
        "# ============================================================\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 1 - IMPORTAR AS BIBLIOTECAS\n",
        "# ============================================================\n",
        "\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "from google.colab import drive, files\n",
        "from IPython.display import display\n",
        "\n",
        "from sklearn.model_selection import (\n",
        "    train_test_split,\n",
        "    KFold,\n",
        "    GridSearchCV\n",
        ")\n",
        "\n",
        "from sklearn.compose import ColumnTransformer\n",
        "\n",
        "from sklearn.pipeline import Pipeline\n",
        "\n",
        "from sklearn.impute import SimpleImputer\n",
        "\n",
        "from sklearn.preprocessing import (\n",
        "    OneHotEncoder,\n",
        "    StandardScaler\n",
        ")\n",
        "\n",
        "from sklearn.linear_model import (\n",
        "    LinearRegression,\n",
        "    Lasso,\n",
        "    Ridge,\n",
        "    ElasticNet\n",
        ")\n",
        "\n",
        "from sklearn.metrics import (\n",
        "    mean_absolute_error,\n",
        "    mean_squared_error,\n",
        "    r2_score\n",
        ")\n",
        "\n",
        "print(\"Bibliotecas carregadas com sucesso!\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 2 - CONECTAR AO GOOGLE DRIVE\n",
        "# ============================================================\n",
        "\n",
        "# O Google solicitará autorização de acesso.\n",
        "\n",
        "drive.mount(\"/content/drive\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 3 - CAMINHO DO ARQUIVO EXCEL\n",
        "#\n",
        "# ATENÇÃO! ALTERE SOMENTE A LINHA ABAIXO.\n",
        "#\n",
        "# Copie o caminho do arquivo que está no seu Drive\n",
        "# e cole entre as aspas.\n",
        "#\n",
        "# Exemplo, se o arquivo estiver na pasta Dados:\n",
        "#\n",
        "# \"/content/drive/MyDrive/Dados/arquivo.xlsx\"\n",
        "# ============================================================\n",
        "\n",
        "CAMINHO_ARQUIVO = \"/content/drive/MyDrive/Sales_transactions_2022_2025(1).xlsx\"\n",
        "\n",
        "# ============================================================\n",
        "# FIM DA PARTE QUE VOCÊ PRECISA ALTERAR\n",
        "# ============================================================\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 4 - CARREGAR O DATASET\n",
        "# ============================================================\n",
        "\n",
        "# Lê o arquivo original.\n",
        "df_original = pd.read_excel(CAMINHO_ARQUIVO)\n",
        "\n",
        "# Cria uma cópia independente para a análise.\n",
        "df = df_original.copy(deep=True)\n",
        "\n",
        "print(\"\\nDATASET CARREGADO!\")\n",
        "\n",
        "print(\"Número de observações:\", df.shape[0])\n",
        "\n",
        "print(\"Número de variáveis:\", df.shape[1])\n",
        "\n",
        "print(\"\\nPrimeiras cinco observações:\")\n",
        "\n",
        "display(df.head())\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 5 - DEFINIR A VARIÁVEL DEPENDENTE\n",
        "# ============================================================\n",
        "\n",
        "# Variável que queremos prever:\n",
        "# Sales_Amount = valor da venda.\n",
        "\n",
        "variavel_alvo = \"Sales_Amount\"\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 6 - DEFINIR OS OITO PREDITORES\n",
        "# ============================================================\n",
        "\n",
        "# Variáveis quantitativas:\n",
        "\n",
        "preditores_numericos = [\n",
        "    \"Customer_Age\",\n",
        "    \"Unit_Price\",\n",
        "    \"Quantity\",\n",
        "    \"Discount_Percentage\",\n",
        "    \"Customer_Rating\"\n",
        "]\n",
        "\n",
        "# Variáveis qualitativas nominais:\n",
        "\n",
        "preditores_categoricos = [\n",
        "    \"Customer_Segment\",\n",
        "    \"Sales_Channel\",\n",
        "    \"Product_Category\"\n",
        "]\n",
        "\n",
        "# Relação completa de preditores:\n",
        "\n",
        "preditores = (\n",
        "    preditores_numericos +\n",
        "    preditores_categoricos\n",
        ")\n",
        "\n",
        "print(\"\\nVARIÁVEL DEPENDENTE:\")\n",
        "print(variavel_alvo)\n",
        "\n",
        "print(\"\\nPREDITORES:\")\n",
        "for nome in preditores:\n",
        "    print(\"-\", nome)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 7 - VERIFICAR A EXISTÊNCIA DAS COLUNAS\n",
        "# ============================================================\n",
        "\n",
        "colunas_necessarias = (\n",
        "    preditores + [variavel_alvo]\n",
        ")\n",
        "\n",
        "colunas_faltantes = [\n",
        "    coluna\n",
        "    for coluna in colunas_necessarias\n",
        "    if coluna not in df.columns\n",
        "]\n",
        "\n",
        "if colunas_faltantes:\n",
        "    raise ValueError(\n",
        "        \"Colunas não encontradas: \"\n",
        "        + str(colunas_faltantes)\n",
        "    )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 8 - PREPARAR UMA CÓPIA DOS DADOS\n",
        "# ============================================================\n",
        "\n",
        "# Selecionamos somente as nove variáveis necessárias.\n",
        "# O arquivo original permanece intacto.\n",
        "\n",
        "dados = df[colunas_necessarias].copy()\n",
        "\n",
        "# Converter colunas numéricas para formato numérico.\n",
        "# Valores não interpretáveis são marcados como ausentes.\n",
        "\n",
        "for coluna in (\n",
        "    preditores_numericos + [variavel_alvo]\n",
        "):\n",
        "    dados[coluna] = pd.to_numeric(\n",
        "        dados[coluna],\n",
        "        errors=\"coerce\"\n",
        "    )\n",
        "\n",
        "# Nas variáveis categóricas, células vazias\n",
        "# ou preenchidas apenas com espaços viram ausentes.\n",
        "\n",
        "for coluna in preditores_categoricos:\n",
        "    dados[coluna] = (\n",
        "        dados[coluna]\n",
        "        .replace(r\"^\\s*$\", np.nan, regex=True)\n",
        "        .astype(\"object\")\n",
        "    )\n",
        "\n",
        "# A regressão supervisionada precisa conhecer\n",
        "# o valor real da variável dependente.\n",
        "#\n",
        "# Portanto, removemos da cópia somente registros\n",
        "# que não possuem Sales_Amount válido.\n",
        "\n",
        "total_antes = len(dados)\n",
        "\n",
        "dados = dados.dropna(\n",
        "    subset=[variavel_alvo]\n",
        ").copy()\n",
        "\n",
        "total_depois = len(dados)\n",
        "\n",
        "print(\"\\nREGISTROS EXCLUÍDOS DA CÓPIA POR ALVO AUSENTE:\")\n",
        "print(total_antes - total_depois)\n",
        "\n",
        "# A planilha original não sofreu alterações.\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 9 - ANÁLISE DESCRITIVA INICIAL\n",
        "# ============================================================\n",
        "\n",
        "print(\"\\nESTATÍSTICA DESCRITIVA:\")\n",
        "\n",
        "display(\n",
        "    dados[\n",
        "        preditores_numericos + [variavel_alvo]\n",
        "    ].describe().T\n",
        ")\n",
        "\n",
        "print(\"\\nVALORES AUSENTES:\")\n",
        "\n",
        "tabela_ausentes = pd.DataFrame({\n",
        "    \"Ausentes\": dados.isna().sum(),\n",
        "    \"Percentual (%)\": (\n",
        "        dados.isna().mean() * 100\n",
        "    ).round(2)\n",
        "})\n",
        "\n",
        "display(tabela_ausentes)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 10 - SEPARAR X E y\n",
        "# ============================================================\n",
        "\n",
        "# X = variáveis explicativas.\n",
        "# y = variável que queremos prever.\n",
        "\n",
        "X = dados[preditores].copy()\n",
        "\n",
        "y = dados[variavel_alvo].copy()\n",
        "\n",
        "print(\"\\nDimensões de X:\", X.shape)\n",
        "print(\"Dimensões de y:\", y.shape)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 11 - DIVIDIR TREINAMENTO E TESTE\n",
        "# ============================================================\n",
        "\n",
        "# 80% para desenvolver e selecionar o modelo.\n",
        "# 20% reservados para o teste final.\n",
        "#\n",
        "# random_state=42 permite reproduzir a divisão.\n",
        "\n",
        "X_treino, X_teste, y_treino, y_teste = (\n",
        "    train_test_split(\n",
        "        X,\n",
        "        y,\n",
        "        test_size=0.20,\n",
        "        random_state=42\n",
        "    )\n",
        ")\n",
        "\n",
        "print(\"\\nDIVISÃO DOS DADOS:\")\n",
        "\n",
        "print(\"Treinamento:\", len(X_treino))\n",
        "print(\"Teste:\", len(X_teste))\n",
        "\n",
        "# IMPORTANTE:\n",
        "# O teste não será usado para ajustar imputações,\n",
        "# escalonamento ou escolher hiperparâmetros.\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 12 - PIPELINE DAS VARIÁVEIS NUMÉRICAS\n",
        "# ============================================================\n",
        "\n",
        "# Passo 1: substituir valores ausentes pela mediana.\n",
        "# Passo 2: padronizar as variáveis pelo StandardScaler.\n",
        "#\n",
        "# A mediana e os parâmetros de padronização serão\n",
        "# calculados somente nos dados de treinamento.\n",
        "\n",
        "pipeline_numerico = Pipeline(\n",
        "    steps=[\n",
        "        (\n",
        "            \"imputacao\",\n",
        "            SimpleImputer(strategy=\"median\")\n",
        "        ),\n",
        "        (\n",
        "            \"padronizacao\",\n",
        "            StandardScaler()\n",
        "        )\n",
        "    ]\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 13 - PIPELINE DAS VARIÁVEIS CATEGÓRICAS\n",
        "# ============================================================\n",
        "\n",
        "# Passo 1: imputar valores ausentes pela moda.\n",
        "# Passo 2: aplicar One-Hot Encoding.\n",
        "#\n",
        "# Uma categoria nominal não possui necessariamente\n",
        "# ordem numérica. O One-Hot evita impor essa ordem.\n",
        "#\n",
        "# handle_unknown=\"ignore\" evita erro quando uma\n",
        "# categoria nova aparece no conjunto de teste.\n",
        "\n",
        "pipeline_categorico = Pipeline(\n",
        "    steps=[\n",
        "        (\n",
        "            \"imputacao\",\n",
        "            SimpleImputer(\n",
        "                strategy=\"most_frequent\"\n",
        "            )\n",
        "        ),\n",
        "        (\n",
        "            \"onehot\",\n",
        "            OneHotEncoder(\n",
        "                handle_unknown=\"ignore\"\n",
        "            )\n",
        "        )\n",
        "    ]\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 14 - UNIR OS PRÉ-PROCESSAMENTOS\n",
        "# ============================================================\n",
        "\n",
        "preprocessador = ColumnTransformer(\n",
        "    transformers=[\n",
        "        (\n",
        "            \"numericas\",\n",
        "            pipeline_numerico,\n",
        "            preditores_numericos\n",
        "        ),\n",
        "        (\n",
        "            \"categoricas\",\n",
        "            pipeline_categorico,\n",
        "            preditores_categoricos\n",
        "        )\n",
        "    ]\n",
        ")\n",
        "\n",
        "print(\"\\nPré-processador configurado!\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 15 - DEFINIR O PIPELINE COMPLETO\n",
        "# ============================================================\n",
        "\n",
        "# O pipeline executará:\n",
        "#\n",
        "# 1. Imputação de missing values\n",
        "# 2. Padronização das variáveis numéricas\n",
        "# 3. One-Hot Encoding das categóricas\n",
        "# 4. Ajuste do algoritmo de regressão\n",
        "\n",
        "pipeline = Pipeline(\n",
        "    steps=[\n",
        "        (\n",
        "            \"preprocessamento\",\n",
        "            preprocessador\n",
        "        ),\n",
        "        (\n",
        "            \"modelo\",\n",
        "            LinearRegression()\n",
        "        )\n",
        "    ]\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 16 - DEFINIR OS QUATRO ALGORITMOS\n",
        "# ============================================================\n",
        "\n",
        "# O GridSearchCV testará:\n",
        "#\n",
        "# REGRESSÃO LINEAR:\n",
        "# Sem penalização.\n",
        "#\n",
        "# LASSO:\n",
        "# Regularização L1.\n",
        "#\n",
        "# RIDGE:\n",
        "# Regularização L2.\n",
        "#\n",
        "# ELASTIC NET:\n",
        "# Combinação das penalizações L1 e L2.\n",
        "#\n",
        "# alpha regula a intensidade da penalização.\n",
        "# l1_ratio regula a composição L1/L2.\n",
        "\n",
        "grade_parametros = [\n",
        "    {\n",
        "        \"modelo\": [\n",
        "            LinearRegression()\n",
        "        ]\n",
        "    },\n",
        "\n",
        "    {\n",
        "        \"modelo\": [\n",
        "            Lasso(\n",
        "                max_iter=50000,\n",
        "                random_state=42\n",
        "            )\n",
        "        ],\n",
        "        \"modelo__alpha\": [\n",
        "            0.001,\n",
        "            0.01,\n",
        "            0.1,\n",
        "            1.0,\n",
        "            10.0,\n",
        "            100.0\n",
        "        ]\n",
        "    },\n",
        "\n",
        "    {\n",
        "        \"modelo\": [\n",
        "            Ridge()\n",
        "        ],\n",
        "        \"modelo__alpha\": [\n",
        "            0.001,\n",
        "            0.01,\n",
        "            0.1,\n",
        "            1.0,\n",
        "            10.0,\n",
        "            100.0\n",
        "        ]\n",
        "    },\n",
        "\n",
        "    {\n",
        "        \"modelo\": [\n",
        "            ElasticNet(\n",
        "                max_iter=50000,\n",
        "                random_state=42\n",
        "            )\n",
        "        ],\n",
        "        \"modelo__alpha\": [\n",
        "            0.001,\n",
        "            0.01,\n",
        "            0.1,\n",
        "            1.0,\n",
        "            10.0,\n",
        "            100.0\n",
        "        ],\n",
        "        \"modelo__l1_ratio\": [\n",
        "            0.2,\n",
        "            0.5,\n",
        "            0.8\n",
        "        ]\n",
        "    }\n",
        "]\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 17 - CONFIGURAR VALIDAÇÃO CRUZADA K-FOLD\n",
        "# ============================================================\n",
        "\n",
        "# K = 5 significa cinco divisões.\n",
        "#\n",
        "# Em cada rodada:\n",
        "# 4 partes são usadas para treinamento.\n",
        "# 1 parte é usada para validação.\n",
        "#\n",
        "# Depois, ocorre uma troca de papéis entre as partes.\n",
        "\n",
        "validacao = KFold(\n",
        "    n_splits=5,\n",
        "    shuffle=True,\n",
        "    random_state=42\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 18 - COMPARAR OS ALGORITMOS\n",
        "# ============================================================\n",
        "\n",
        "# GridSearchCV:\n",
        "# Compara os modelos e hiperparâmetros.\n",
        "#\n",
        "# scoring=\"neg_root_mean_squared_error\"\n",
        "# significa que queremos minimizar o RMSE.\n",
        "#\n",
        "# O sinal negativo é uma convenção do scikit-learn,\n",
        "# porque sua rotina procura maximizar o score.\n",
        "#\n",
        "# refit=True ajusta novamente o melhor pipeline\n",
        "# usando todos os dados de desenvolvimento.\n",
        "\n",
        "busca = GridSearchCV(\n",
        "    estimator=pipeline,\n",
        "    param_grid=grade_parametros,\n",
        "    scoring=\"neg_root_mean_squared_error\",\n",
        "    cv=validacao,\n",
        "    refit=True,\n",
        "    n_jobs=-1,\n",
        "    verbose=1,\n",
        "    error_score=\"raise\"\n",
        ")\n",
        "\n",
        "print(\"\\nINICIANDO VALIDAÇÃO CRUZADA...\")\n",
        "print(\"Aguarde o processamento dos modelos.\")\n",
        "\n",
        "busca.fit(\n",
        "    X_treino,\n",
        "    y_treino\n",
        ")\n",
        "\n",
        "print(\"\\nVALIDAÇÃO CRUZADA CONCLUÍDA!\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 19 - RESULTADOS DE TODOS OS MODELOS\n",
        "# ============================================================\n",
        "\n",
        "resultados_cv = pd.DataFrame(\n",
        "    busca.cv_results_\n",
        ")\n",
        "\n",
        "# Identificar o nome de cada algoritmo.\n",
        "\n",
        "def nome_algoritmo(modelo):\n",
        "\n",
        "    return type(modelo).__name__\n",
        "\n",
        "\n",
        "resultados_cv[\"Algoritmo\"] = (\n",
        "    resultados_cv[\"param_modelo\"]\n",
        "    .apply(nome_algoritmo)\n",
        ")\n",
        "\n",
        "# Converter RMSE negativo para valor positivo.\n",
        "\n",
        "resultados_cv[\"RMSE_medio\"] = (\n",
        "    -resultados_cv[\"mean_test_score\"]\n",
        ")\n",
        "\n",
        "resultados_cv[\"Desvio_RMSE\"] = (\n",
        "    resultados_cv[\"std_test_score\"]\n",
        ")\n",
        "\n",
        "# Classificar do menor RMSE para o maior.\n",
        "\n",
        "resultados_ordenados = (\n",
        "    resultados_cv\n",
        "    .sort_values(\"RMSE_medio\")\n",
        ")\n",
        "\n",
        "# Guardar a melhor configuração de cada algoritmo.\n",
        "\n",
        "comparacao = (\n",
        "    resultados_ordenados\n",
        "    .drop_duplicates(subset=\"Algoritmo\")\n",
        "    [[\n",
        "        \"Algoritmo\",\n",
        "        \"RMSE_medio\",\n",
        "        \"Desvio_RMSE\",\n",
        "        \"params\"\n",
        "    ]]\n",
        "    .reset_index(drop=True)\n",
        ")\n",
        "\n",
        "print(\"\\nCOMPARAÇÃO DOS QUATRO ALGORITMOS:\")\n",
        "\n",
        "display(comparacao)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 20 - IDENTIFICAR O MELHOR ALGORITMO\n",
        "# ============================================================\n",
        "\n",
        "melhor_pipeline = busca.best_estimator_\n",
        "\n",
        "melhor_algoritmo = nome_algoritmo(\n",
        "    melhor_pipeline.named_steps[\"modelo\"]\n",
        ")\n",
        "\n",
        "print(\"\\n====================================\")\n",
        "print(\"MELHOR ALGORITMO:\", melhor_algoritmo)\n",
        "\n",
        "print(\n",
        "    \"RMSE médio da validação:\",\n",
        "    round(-busca.best_score_, 4)\n",
        ")\n",
        "\n",
        "print(\"\\nMelhores parâmetros:\")\n",
        "\n",
        "print(busca.best_params_)\n",
        "\n",
        "print(\"====================================\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 21 - REALIZAR O TESTE FINAL\n",
        "# ============================================================\n",
        "\n",
        "# Só agora utilizamos os 20% reservados.\n",
        "#\n",
        "# Nenhum parâmetro do modelo será ajustado\n",
        "# utilizando essas observações.\n",
        "\n",
        "y_previsto = melhor_pipeline.predict(\n",
        "    X_teste\n",
        ")\n",
        "\n",
        "# MAE = erro absoluto médio.\n",
        "mae = mean_absolute_error(\n",
        "    y_teste,\n",
        "    y_previsto\n",
        ")\n",
        "\n",
        "# RMSE = raiz do erro quadrático médio.\n",
        "rmse = np.sqrt(\n",
        "    mean_squared_error(\n",
        "        y_teste,\n",
        "        y_previsto\n",
        "    )\n",
        ")\n",
        "\n",
        "# R² = coeficiente de determinação.\n",
        "r2 = r2_score(\n",
        "    y_teste,\n",
        "    y_previsto\n",
        ")\n",
        "\n",
        "# WAPE = soma dos erros absolutos dividida\n",
        "# pela soma dos valores absolutos observados.\n",
        "\n",
        "denominador = np.abs(y_teste).sum()\n",
        "\n",
        "wape = (\n",
        "    np.abs(y_teste - y_previsto).sum()\n",
        "    / denominador * 100\n",
        "    if denominador > 0\n",
        "    else np.nan\n",
        ")\n",
        "\n",
        "print(\"\\nRESULTADOS DO TESTE FINAL:\")\n",
        "\n",
        "print(\"MAE:\", round(mae, 4))\n",
        "print(\"RMSE:\", round(rmse, 4))\n",
        "print(\"R²:\", round(r2, 4))\n",
        "print(\"WAPE (%):\", round(wape, 2))\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 22 - GRÁFICO COMPARATIVO DOS ALGORITMOS\n",
        "# ============================================================\n",
        "\n",
        "plt.figure(figsize=(10, 5))\n",
        "\n",
        "plt.bar(\n",
        "    comparacao[\"Algoritmo\"],\n",
        "    comparacao[\"RMSE_medio\"]\n",
        ")\n",
        "\n",
        "plt.ylabel(\"RMSE médio na validação\")\n",
        "plt.xlabel(\"Algoritmo\")\n",
        "plt.title(\"Comparação dos modelos de regressão\")\n",
        "\n",
        "plt.xticks(rotation=20)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 23 - COMPARAR VENDAS REAIS E PREVISTAS\n",
        "# ============================================================\n",
        "\n",
        "plt.figure(figsize=(8, 6))\n",
        "\n",
        "plt.scatter(\n",
        "    y_teste,\n",
        "    y_previsto,\n",
        "    alpha=0.45\n",
        ")\n",
        "\n",
        "menor = min(\n",
        "    y_teste.min(),\n",
        "    y_previsto.min()\n",
        ")\n",
        "\n",
        "maior = max(\n",
        "    y_teste.max(),\n",
        "    y_previsto.max()\n",
        ")\n",
        "\n",
        "# Linha de previsão perfeita.\n",
        "plt.plot(\n",
        "    [menor, maior],\n",
        "    [menor, maior],\n",
        "    \"r--\",\n",
        "    label=\"Previsão perfeita\"\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Valor real da venda\")\n",
        "plt.ylabel(\"Valor previsto da venda\")\n",
        "\n",
        "plt.title(\n",
        "    \"Valores reais versus valores previstos\"\n",
        ")\n",
        "\n",
        "plt.legend()\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 24 - ANÁLISE DOS RESÍDUOS\n",
        "# ============================================================\n",
        "\n",
        "# Resíduo = valor real - valor previsto.\n",
        "#\n",
        "# Se o valor é positivo:\n",
        "# o modelo subestimou a venda.\n",
        "#\n",
        "# Se o valor é negativo:\n",
        "# o modelo superestimou a venda.\n",
        "\n",
        "residuos = y_teste - y_previsto\n",
        "\n",
        "print(\"\\nESTATÍSTICA DESCRITIVA DOS RESÍDUOS:\")\n",
        "\n",
        "display(\n",
        "    pd.Series(residuos).describe()\n",
        ")\n",
        "\n",
        "# Histograma dos resíduos\n",
        "\n",
        "plt.figure(figsize=(10, 5))\n",
        "\n",
        "plt.hist(\n",
        "    residuos,\n",
        "    bins=40,\n",
        "    edgecolor=\"black\"\n",
        ")\n",
        "\n",
        "plt.axvline(\n",
        "    0,\n",
        "    color=\"red\",\n",
        "    linestyle=\"--\"\n",
        ")\n",
        "\n",
        "plt.title(\"Distribuição dos resíduos\")\n",
        "plt.xlabel(\"Resíduo\")\n",
        "plt.ylabel(\"Frequência\")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# Resíduos versus valores previstos\n",
        "\n",
        "plt.figure(figsize=(10, 5))\n",
        "\n",
        "plt.scatter(\n",
        "    y_previsto,\n",
        "    residuos,\n",
        "    alpha=0.45\n",
        ")\n",
        "\n",
        "plt.axhline(\n",
        "    0,\n",
        "    color=\"red\",\n",
        "    linestyle=\"--\"\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Valor previsto\")\n",
        "plt.ylabel(\"Resíduo\")\n",
        "plt.title(\"Resíduos versus previsões\")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 25 - ANALISAR OS COEFICIENTES\n",
        "# ============================================================\n",
        "\n",
        "# Como os modelos são lineares, é possível verificar\n",
        "# os coeficientes associados a cada variável após\n",
        "# o pré-processamento.\n",
        "\n",
        "nomes_variaveis = (\n",
        "    melhor_pipeline\n",
        "    .named_steps[\"preprocessamento\"]\n",
        "    .get_feature_names_out()\n",
        ")\n",
        "\n",
        "coeficientes = (\n",
        "    melhor_pipeline\n",
        "    .named_steps[\"modelo\"]\n",
        "    .coef_\n",
        ")\n",
        "\n",
        "tabela_coeficientes = pd.DataFrame({\n",
        "    \"Variável transformada\": nomes_variaveis,\n",
        "    \"Coeficiente\": coeficientes\n",
        "})\n",
        "\n",
        "tabela_coeficientes[\"Valor_absoluto\"] = (\n",
        "    tabela_coeficientes[\"Coeficiente\"].abs()\n",
        ")\n",
        "\n",
        "tabela_coeficientes = (\n",
        "    tabela_coeficientes\n",
        "    .sort_values(\n",
        "        \"Valor_absoluto\",\n",
        "        ascending=False\n",
        "    )\n",
        ")\n",
        "\n",
        "print(\"\\nCOEFICIENTES DO MELHOR MODELO:\")\n",
        "\n",
        "display(\n",
        "    tabela_coeficientes.drop(\n",
        "        columns=\"Valor_absoluto\"\n",
        "    )\n",
        ")\n",
        "\n",
        "# Atenção:\n",
        "# Os coeficientes numéricos correspondem às\n",
        "# variáveis padronizadas.\n",
        "#\n",
        "# Coeficientes não demonstram causalidade.\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 26 - VERIFICAR A FÓRMULA COMERCIAL\n",
        "# ============================================================\n",
        "\n",
        "# Em muitos sistemas:\n",
        "#\n",
        "# Valor da venda =\n",
        "# Preço unitário * Quantidade *\n",
        "# (1 - Desconto percentual / 100)\n",
        "#\n",
        "# Vamos verificar se essa fórmula se aproxima\n",
        "# do Sales_Amount registrado.\n",
        "#\n",
        "# Este é um diagnóstico separado dos modelos.\n",
        "# Não altera a seleção do algoritmo.\n",
        "\n",
        "formula_venda = (\n",
        "    X_teste[\"Unit_Price\"]\n",
        "    * X_teste[\"Quantity\"]\n",
        "    * (\n",
        "        1 -\n",
        "        X_teste[\"Discount_Percentage\"] / 100\n",
        "    )\n",
        ")\n",
        "\n",
        "mascara_formula = (\n",
        "    formula_venda.notna() &\n",
        "    np.isfinite(formula_venda)\n",
        ")\n",
        "\n",
        "if mascara_formula.any():\n",
        "\n",
        "    real_formula = y_teste.loc[\n",
        "        mascara_formula\n",
        "    ]\n",
        "\n",
        "    previsto_formula = formula_venda.loc[\n",
        "        mascara_formula\n",
        "    ]\n",
        "\n",
        "    erro_formula = mean_absolute_error(\n",
        "        real_formula,\n",
        "        previsto_formula\n",
        "    )\n",
        "\n",
        "    print(\"\\nVERIFICAÇÃO DA FÓRMULA COMERCIAL:\")\n",
        "\n",
        "    print(\n",
        "        \"MAE da fórmula:\",\n",
        "        round(erro_formula, 4)\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        \"Registros verificados:\",\n",
        "        int(mascara_formula.sum())\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        \"Esta verificação não substitui \"\n",
        "        \"a avaliação do modelo escolhido.\"\n",
        "    )\n",
        "\n",
        "else:\n",
        "    print(\n",
        "        \"\\nNão há observações suficientes \"\n",
        "        \"para verificar a fórmula comercial.\"\n",
        "    )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 27 - GERAR TABELA DE PREVISÕES\n",
        "# ============================================================\n",
        "\n",
        "# Organizar os resultados do teste em uma tabela.\n",
        "\n",
        "tabela_previsoes = X_teste.copy()\n",
        "\n",
        "tabela_previsoes[\"Venda_Real\"] = (\n",
        "    y_teste\n",
        ")\n",
        "\n",
        "tabela_previsoes[\"Venda_Prevista\"] = (\n",
        "    y_previsto\n",
        ")\n",
        "\n",
        "tabela_previsoes[\"Residuo\"] = (\n",
        "    y_teste - y_previsto\n",
        ")\n",
        "\n",
        "tabela_previsoes[\"Erro_Absoluto\"] = (\n",
        "    np.abs(y_teste - y_previsto)\n",
        ")\n",
        "\n",
        "print(\"\\nAMOSTRA DAS PREVISÕES:\")\n",
        "\n",
        "display(\n",
        "    tabela_previsoes.head(20)\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 28 - EXPORTAR OS RESULTADOS PARA EXCEL\n",
        "# ============================================================\n",
        "\n",
        "nome_relatorio = (\n",
        "    \"Resultado_Machine_Learning_Vendas.xlsx\"\n",
        ")\n",
        "\n",
        "metricas_finais = pd.DataFrame({\n",
        "    \"Indicador\": [\n",
        "        \"Melhor algoritmo\",\n",
        "        \"MAE\",\n",
        "        \"RMSE\",\n",
        "        \"R²\",\n",
        "        \"WAPE (%)\"\n",
        "    ],\n",
        "    \"Resultado\": [\n",
        "        melhor_algoritmo,\n",
        "        mae,\n",
        "        rmse,\n",
        "        r2,\n",
        "        wape\n",
        "    ]\n",
        "})\n",
        "\n",
        "with pd.ExcelWriter(\n",
        "    nome_relatorio,\n",
        "    engine=\"openpyxl\"\n",
        ") as writer:\n",
        "\n",
        "    comparacao.to_excel(\n",
        "        writer,\n",
        "        sheet_name=\"Comparacao_Modelos\",\n",
        "        index=False\n",
        "    )\n",
        "\n",
        "    metricas_finais.to_excel(\n",
        "        writer,\n",
        "        sheet_name=\"Metricas_Teste\",\n",
        "        index=False\n",
        "    )\n",
        "\n",
        "    tabela_coeficientes.drop(\n",
        "        columns=\"Valor_absoluto\"\n",
        "    ).to_excel(\n",
        "        writer,\n",
        "        sheet_name=\"Coeficientes\",\n",
        "        index=False\n",
        "    )\n",
        "\n",
        "    tabela_previsoes.to_excel(\n",
        "        writer,\n",
        "        sheet_name=\"Previsoes\",\n",
        "        index=False\n",
        "    )\n",
        "\n",
        "print(\"\\nRELATÓRIO EXCEL GERADO!\")\n",
        "\n",
        "files.download(nome_relatorio)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 29 - CONCLUSÃO\n",
        "# ============================================================\n",
        "\n",
        "print(\"\\n====================================\")\n",
        "print(\"ANÁLISE FINALIZADA\")\n",
        "print(\"====================================\")\n",
        "\n",
        "print(\"Melhor algoritmo:\", melhor_algoritmo)\n",
        "\n",
        "print(\"RMSE no teste:\", round(rmse, 4))\n",
        "\n",
        "print(\"R² no teste:\", round(r2, 4))\n",
        "\n",
        "print(\"\\nO DATASET ORIGINAL FOI PRESERVADO.\")\n",
        "\n",
        "print(\n",
        "    \"A seleção dos modelos foi realizada \"\n",
        "    \"somente nos dados de desenvolvimento.\"\n",
        ")\n"
      ],
      "metadata": {
        "id": "sZjbIpaWlZ1h"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "# ============================================================\n",
        "# MACHINE LEARNING - PREVISÃO DO VALOR DAS VENDAS\n",
        "# Dataset: Sales_transactions_2022_2025\n",
        "#\n",
        "# Algoritmos:\n",
        "# 1. Regressão Linear\n",
        "# 2. Lasso - Regularização L1\n",
        "# 3. Ridge - Regularização L2\n",
        "# 4. Elastic Net - Regularização L1 + L2\n",
        "#\n",
        "# Método:\n",
        "# Pipeline + GridSearchCV + K-Fold (5 divisões)\n",
        "#\n",
        "# IMPORTANTE:\n",
        "# O arquivo Excel original não será alterado.\n",
        "# ============================================================\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 1 - IMPORTAR AS BIBLIOTECAS\n",
        "# ============================================================\n",
        "\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "from google.colab import drive, files\n",
        "from IPython.display import display\n",
        "\n",
        "from sklearn.model_selection import (\n",
        "    train_test_split,\n",
        "    KFold,\n",
        "    GridSearchCV\n",
        ")\n",
        "\n",
        "from sklearn.compose import ColumnTransformer\n",
        "\n",
        "from sklearn.pipeline import Pipeline\n",
        "\n",
        "from sklearn.impute import SimpleImputer\n",
        "\n",
        "from sklearn.preprocessing import (\n",
        "    OneHotEncoder,\n",
        "    StandardScaler\n",
        ")\n",
        "\n",
        "from sklearn.linear_model import (\n",
        "    LinearRegression,\n",
        "    Lasso,\n",
        "    Ridge,\n",
        "    ElasticNet\n",
        ")\n",
        "\n",
        "from sklearn.metrics import (\n",
        "    mean_absolute_error,\n",
        "    mean_squared_error,\n",
        "    r2_score\n",
        ")\n",
        "\n",
        "print(\"Bibliotecas carregadas com sucesso!\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 2 - CONECTAR AO GOOGLE DRIVE\n",
        "# ============================================================\n",
        "\n",
        "# O Google solicitará autorização de acesso.\n",
        "\n",
        "drive.mount(\"/content/drive\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 3 - CAMINHO DO ARQUIVO EXCEL\n",
        "#\n",
        "# ATENÇÃO! ALTERE SOMENTE A LINHA ABAIXO.\n",
        "#\n",
        "# Copie o caminho do arquivo que está no seu Drive\n",
        "# e cole entre as aspas.\n",
        "#\n",
        "# Exemplo, se o arquivo estiver na pasta Dados:\n",
        "#\n",
        "# \"/content/drive/MyDrive/Dados/arquivo.xlsx\"\n",
        "# ============================================================\n",
        "\n",
        "CAMINHO_ARQUIVO = \"/content/drive/MyDrive/Banco de Dados 1/Sales_transactions_2022_2025.xlsx\"\n",
        "\n",
        "# ============================================================\n",
        "# FIM DA PARTE QUE VOCÊ PRECISA ALTERAR\n",
        "# ============================================================\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 4 - CARREGAR O DATASET\n",
        "# ============================================================\n",
        "\n",
        "# Lê o arquivo original.\n",
        "df_original = pd.read_excel(CAMINHO_ARQUIVO)\n",
        "\n",
        "# Cria uma cópia independente para a análise.\n",
        "df = df_original.copy(deep=True)\n",
        "\n",
        "print(\"\\nDATASET CARREGADO!\")\n",
        "\n",
        "print(\"Número de observações:\", df.shape[0])\n",
        "\n",
        "print(\"Número de variáveis:\", df.shape[1])\n",
        "\n",
        "print(\"\\nPrimeiras cinco observações:\")\n",
        "\n",
        "display(df.head())\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 5 - DEFINIR A VARIÁVEL DEPENDENTE\n",
        "# ============================================================\n",
        "\n",
        "# Variável que queremos prever:\n",
        "# Sales_Amount = valor da venda.\n",
        "\n",
        "variavel_alvo = \"Sales_Amount\"\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 6 - DEFINIR OS OITO PREDITORES\n",
        "# ============================================================\n",
        "\n",
        "# Variáveis quantitativas:\n",
        "\n",
        "preditores_numericos = [\n",
        "    \"Customer_Age\",\n",
        "    \"Unit_Price\",\n",
        "    \"Quantity\",\n",
        "    \"Discount_Percentage\",\n",
        "    \"Customer_Rating\"\n",
        "]\n",
        "\n",
        "# Variáveis qualitativas nominais:\n",
        "\n",
        "preditores_categoricos = [\n",
        "    \"Customer_Segment\",\n",
        "    \"Sales_Channel\",\n",
        "    \"Product_Category\"\n",
        "]\n",
        "\n",
        "# Relação completa de preditores:\n",
        "\n",
        "preditores = (\n",
        "    preditores_numericos +\n",
        "    preditores_categoricos\n",
        ")\n",
        "\n",
        "print(\"\\nVARIÁVEL DEPENDENTE:\")\n",
        "print(variavel_alvo)\n",
        "\n",
        "print(\"\\nPREDITORES:\")\n",
        "for nome in preditores:\n",
        "    print(\"-\", nome)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 7 - VERIFICAR A EXISTÊNCIA DAS COLUNAS\n",
        "# ============================================================\n",
        "\n",
        "colunas_necessarias = (\n",
        "    preditores + [variavel_alvo]\n",
        ")\n",
        "\n",
        "colunas_faltantes = [\n",
        "    coluna\n",
        "    for coluna in colunas_necessarias\n",
        "    if coluna not in df.columns\n",
        "]\n",
        "\n",
        "if colunas_faltantes:\n",
        "    raise ValueError(\n",
        "        \"Colunas não encontradas: \"\n",
        "        + str(colunas_faltantes)\n",
        "    )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 8 - PREPARAR UMA CÓPIA DOS DADOS\n",
        "# ============================================================\n",
        "\n",
        "# Selecionamos somente as nove variáveis necessárias.\n",
        "# O arquivo original permanece intacto.\n",
        "\n",
        "dados = df[colunas_necessarias].copy()\n",
        "\n",
        "# Converter colunas numéricas para formato numérico.\n",
        "# Valores não interpretáveis são marcados como ausentes.\n",
        "\n",
        "for coluna in (\n",
        "    preditores_numericos + [variavel_alvo]\n",
        "):\n",
        "    dados[coluna] = pd.to_numeric(\n",
        "        dados[coluna],\n",
        "        errors=\"coerce\"\n",
        "    )\n",
        "\n",
        "# Nas variáveis categóricas, células vazias\n",
        "# ou preenchidas apenas com espaços viram ausentes.\n",
        "\n",
        "for coluna in preditores_categoricos:\n",
        "    dados[coluna] = (\n",
        "        dados[coluna]\n",
        "        .replace(r\"^\\s*$\", np.nan, regex=True)\n",
        "        .astype(\"object\")\n",
        "    )\n",
        "\n",
        "# A regressão supervisionada precisa conhecer\n",
        "# o valor real da variável dependente.\n",
        "#\n",
        "# Portanto, removemos da cópia somente registros\n",
        "# que não possuem Sales_Amount válido.\n",
        "\n",
        "total_antes = len(dados)\n",
        "\n",
        "dados = dados.dropna(\n",
        "    subset=[variavel_alvo]\n",
        ").copy()\n",
        "\n",
        "total_depois = len(dados)\n",
        "\n",
        "print(\"\\nREGISTROS EXCLUÍDOS DA CÓPIA POR ALVO AUSENTE:\")\n",
        "print(total_antes - total_depois)\n",
        "\n",
        "# A planilha original não sofreu alterações.\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 9 - ANÁLISE DESCRITIVA INICIAL\n",
        "# ============================================================\n",
        "\n",
        "print(\"\\nESTATÍSTICA DESCRITIVA:\")\n",
        "\n",
        "display(\n",
        "    dados[\n",
        "        preditores_numericos + [variavel_alvo]\n",
        "    ].describe().T\n",
        ")\n",
        "\n",
        "print(\"\\nVALORES AUSENTES:\")\n",
        "\n",
        "tabela_ausentes = pd.DataFrame({\n",
        "    \"Ausentes\": dados.isna().sum(),\n",
        "    \"Percentual (%)\": (\n",
        "        dados.isna().mean() * 100\n",
        "    ).round(2)\n",
        "})\n",
        "\n",
        "display(tabela_ausentes)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 10 - SEPARAR X E y\n",
        "# ============================================================\n",
        "\n",
        "# X = variáveis explicativas.\n",
        "# y = variável que queremos prever.\n",
        "\n",
        "X = dados[preditores].copy()\n",
        "\n",
        "y = dados[variavel_alvo].copy()\n",
        "\n",
        "print(\"\\nDimensões de X:\", X.shape)\n",
        "print(\"Dimensões de y:\", y.shape)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 11 - DIVIDIR TREINAMENTO E TESTE\n",
        "# ============================================================\n",
        "\n",
        "# 80% para desenvolver e selecionar o modelo.\n",
        "# 20% reservados para o teste final.\n",
        "#\n",
        "# random_state=42 permite reproduzir a divisão.\n",
        "\n",
        "X_treino, X_teste, y_treino, y_teste = (\n",
        "    train_test_split(\n",
        "        X,\n",
        "        y,\n",
        "        test_size=0.20,\n",
        "        random_state=42\n",
        "    )\n",
        ")\n",
        "\n",
        "print(\"\\nDIVISÃO DOS DADOS:\")\n",
        "\n",
        "print(\"Treinamento:\", len(X_treino))\n",
        "print(\"Teste:\", len(X_teste))\n",
        "\n",
        "# IMPORTANTE:\n",
        "# O teste não será usado para ajustar imputações,\n",
        "# escalonamento ou escolher hiperparâmetros.\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 12 - PIPELINE DAS VARIÁVEIS NUMÉRICAS\n",
        "# ============================================================\n",
        "\n",
        "# Passo 1: substituir valores ausentes pela mediana.\n",
        "# Passo 2: padronizar as variáveis pelo StandardScaler.\n",
        "#\n",
        "# A mediana e os parâmetros de padronização serão\n",
        "# calculados somente nos dados de treinamento.\n",
        "\n",
        "pipeline_numerico = Pipeline(\n",
        "    steps=[\n",
        "        (\n",
        "            \"imputacao\",\n",
        "            SimpleImputer(strategy=\"median\")\n",
        "        ),\n",
        "        (\n",
        "            \"padronizacao\",\n",
        "            StandardScaler()\n",
        "        )\n",
        "    ]\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 13 - PIPELINE DAS VARIÁVEIS CATEGÓRICAS\n",
        "# ============================================================\n",
        "\n",
        "# Passo 1: imputar valores ausentes pela moda.\n",
        "# Passo 2: aplicar One-Hot Encoding.\n",
        "#\n",
        "# Uma categoria nominal não possui necessariamente\n",
        "# ordem numérica. O One-Hot evita impor essa ordem.\n",
        "#\n",
        "# handle_unknown=\"ignore\" evita erro quando uma\n",
        "# categoria nova aparece no conjunto de teste.\n",
        "\n",
        "pipeline_categorico = Pipeline(\n",
        "    steps=[\n",
        "        (\n",
        "            \"imputacao\",\n",
        "            SimpleImputer(\n",
        "                strategy=\"most_frequent\"\n",
        "            )\n",
        "        ),\n",
        "        (\n",
        "            \"onehot\",\n",
        "            OneHotEncoder(\n",
        "                handle_unknown=\"ignore\"\n",
        "            )\n",
        "        )\n",
        "    ]\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 14 - UNIR OS PRÉ-PROCESSAMENTOS\n",
        "# ============================================================\n",
        "\n",
        "preprocessador = ColumnTransformer(\n",
        "    transformers=[\n",
        "        (\n",
        "            \"numericas\",\n",
        "            pipeline_numerico,\n",
        "            preditores_numericos\n",
        "        ),\n",
        "        (\n",
        "            \"categoricas\",\n",
        "            pipeline_categorico,\n",
        "            preditores_categoricos\n",
        "        )\n",
        "    ]\n",
        ")\n",
        "\n",
        "print(\"\\nPré-processador configurado!\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 15 - DEFINIR O PIPELINE COMPLETO\n",
        "# ============================================================\n",
        "\n",
        "# O pipeline executará:\n",
        "#\n",
        "# 1. Imputação de missing values\n",
        "# 2. Padronização das variáveis numéricas\n",
        "# 3. One-Hot Encoding das categóricas\n",
        "# 4. Ajuste do algoritmo de regressão\n",
        "\n",
        "pipeline = Pipeline(\n",
        "    steps=[\n",
        "        (\n",
        "            \"preprocessamento\",\n",
        "            preprocessador\n",
        "        ),\n",
        "        (\n",
        "            \"modelo\",\n",
        "            LinearRegression()\n",
        "        )\n",
        "    ]\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 16 - DEFINIR OS QUATRO ALGORITMOS\n",
        "# ============================================================\n",
        "\n",
        "# O GridSearchCV testará:\n",
        "#\n",
        "# REGRESSÃO LINEAR:\n",
        "# Sem penalização.\n",
        "#\n",
        "# LASSO:\n",
        "# Regularização L1.\n",
        "#\n",
        "# RIDGE:\n",
        "# Regularização L2.\n",
        "#\n",
        "# ELASTIC NET:\n",
        "# Combinação das penalizações L1 e L2.\n",
        "#\n",
        "# alpha regula a intensidade da penalização.\n",
        "# l1_ratio regula a composição L1/L2.\n",
        "\n",
        "grade_parametros = [\n",
        "    {\n",
        "        \"modelo\": [\n",
        "            LinearRegression()\n",
        "        ]\n",
        "    },\n",
        "\n",
        "    {\n",
        "        \"modelo\": [\n",
        "            Lasso(\n",
        "                max_iter=50000,\n",
        "                random_state=42\n",
        "            )\n",
        "        ],\n",
        "        \"modelo__alpha\": [\n",
        "            0.001,\n",
        "            0.01,\n",
        "            0.1,\n",
        "            1.0,\n",
        "            10.0,\n",
        "            100.0\n",
        "        ]\n",
        "    },\n",
        "\n",
        "    {\n",
        "        \"modelo\": [\n",
        "            Ridge()\n",
        "        ],\n",
        "        \"modelo__alpha\": [\n",
        "            0.001,\n",
        "            0.01,\n",
        "            0.1,\n",
        "            1.0,\n",
        "            10.0,\n",
        "            100.0\n",
        "        ]\n",
        "    },\n",
        "\n",
        "    {\n",
        "        \"modelo\": [\n",
        "            ElasticNet(\n",
        "                max_iter=50000,\n",
        "                random_state=42\n",
        "            )\n",
        "        ],\n",
        "        \"modelo__alpha\": [\n",
        "            0.001,\n",
        "            0.01,\n",
        "            0.1,\n",
        "            1.0,\n",
        "            10.0,\n",
        "            100.0\n",
        "        ],\n",
        "        \"modelo__l1_ratio\": [\n",
        "            0.2,\n",
        "            0.5,\n",
        "            0.8\n",
        "        ]\n",
        "    }\n",
        "]\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 17 - CONFIGURAR VALIDAÇÃO CRUZADA K-FOLD\n",
        "# ============================================================\n",
        "\n",
        "# K = 5 significa cinco divisões.\n",
        "#\n",
        "# Em cada rodada:\n",
        "# 4 partes são usadas para treinamento.\n",
        "# 1 parte é usada para validação.\n",
        "#\n",
        "# Depois, ocorre uma troca de papéis entre as partes.\n",
        "\n",
        "validacao = KFold(\n",
        "    n_splits=5,\n",
        "    shuffle=True,\n",
        "    random_state=42\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 18 - COMPARAR OS ALGORITMOS\n",
        "# ============================================================\n",
        "\n",
        "# GridSearchCV:\n",
        "# Compara os modelos e hiperparâmetros.\n",
        "#\n",
        "# scoring=\"neg_root_mean_squared_error\"\n",
        "# significa que queremos minimizar o RMSE.\n",
        "#\n",
        "# O sinal negativo é uma convenção do scikit-learn,\n",
        "# porque sua rotina procura maximizar o score.\n",
        "#\n",
        "# refit=True ajusta novamente o melhor pipeline\n",
        "# usando todos os dados de desenvolvimento.\n",
        "\n",
        "busca = GridSearchCV(\n",
        "    estimator=pipeline,\n",
        "    param_grid=grade_parametros,\n",
        "    scoring=\"neg_root_mean_squared_error\",\n",
        "    cv=validacao,\n",
        "    refit=True,\n",
        "    n_jobs=-1,\n",
        "    verbose=1,\n",
        "    error_score=\"raise\"\n",
        ")\n",
        "\n",
        "print(\"\\nINICIANDO VALIDAÇÃO CRUZADA...\")\n",
        "print(\"Aguarde o processamento dos modelos.\")\n",
        "\n",
        "busca.fit(\n",
        "    X_treino,\n",
        "    y_treino\n",
        ")\n",
        "\n",
        "print(\"\\nVALIDAÇÃO CRUZADA CONCLUÍDA!\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 19 - RESULTADOS DE TODOS OS MODELOS\n",
        "# ============================================================\n",
        "\n",
        "resultados_cv = pd.DataFrame(\n",
        "    busca.cv_results_\n",
        ")\n",
        "\n",
        "# Identificar o nome de cada algoritmo.\n",
        "\n",
        "def nome_algoritmo(modelo):\n",
        "\n",
        "    return type(modelo).__name__\n",
        "\n",
        "\n",
        "resultados_cv[\"Algoritmo\"] = (\n",
        "    resultados_cv[\"param_modelo\"]\n",
        "    .apply(nome_algoritmo)\n",
        ")\n",
        "\n",
        "# Converter RMSE negativo para valor positivo.\n",
        "\n",
        "resultados_cv[\"RMSE_medio\"] = (\n",
        "    -resultados_cv[\"mean_test_score\"]\n",
        ")\n",
        "\n",
        "resultados_cv[\"Desvio_RMSE\"] = (\n",
        "    resultados_cv[\"std_test_score\"]\n",
        ")\n",
        "\n",
        "# Classificar do menor RMSE para o maior.\n",
        "\n",
        "resultados_ordenados = (\n",
        "    resultados_cv\n",
        "    .sort_values(\"RMSE_medio\")\n",
        ")\n",
        "\n",
        "# Guardar a melhor configuração de cada algoritmo.\n",
        "\n",
        "comparacao = (\n",
        "    resultados_ordenados\n",
        "    .drop_duplicates(subset=\"Algoritmo\")\n",
        "    [[\n",
        "        \"Algoritmo\",\n",
        "        \"RMSE_medio\",\n",
        "        \"Desvio_RMSE\",\n",
        "        \"params\"\n",
        "    ]]\n",
        "    .reset_index(drop=True)\n",
        ")\n",
        "\n",
        "print(\"\\nCOMPARAÇÃO DOS QUATRO ALGORITMOS:\")\n",
        "\n",
        "display(comparacao)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 20 - IDENTIFICAR O MELHOR ALGORITMO\n",
        "# ============================================================\n",
        "\n",
        "melhor_pipeline = busca.best_estimator_\n",
        "\n",
        "melhor_algoritmo = nome_algoritmo(\n",
        "    melhor_pipeline.named_steps[\"modelo\"]\n",
        ")\n",
        "\n",
        "print(\"\\n====================================\")\n",
        "print(\"MELHOR ALGORITMO:\", melhor_algoritmo)\n",
        "\n",
        "print(\n",
        "    \"RMSE médio da validação:\",\n",
        "    round(-busca.best_score_, 4)\n",
        ")\n",
        "\n",
        "print(\"\\nMelhores parâmetros:\")\n",
        "\n",
        "print(busca.best_params_)\n",
        "\n",
        "print(\"====================================\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 21 - REALIZAR O TESTE FINAL\n",
        "# ============================================================\n",
        "\n",
        "# Só agora utilizamos os 20% reservados.\n",
        "#\n",
        "# Nenhum parâmetro do modelo será ajustado\n",
        "# utilizando essas observações.\n",
        "\n",
        "y_previsto = melhor_pipeline.predict(\n",
        "    X_teste\n",
        ")\n",
        "\n",
        "# MAE = erro absoluto médio.\n",
        "mae = mean_absolute_error(\n",
        "    y_teste,\n",
        "    y_previsto\n",
        ")\n",
        "\n",
        "# RMSE = raiz do erro quadrático médio.\n",
        "rmse = np.sqrt(\n",
        "    mean_squared_error(\n",
        "        y_teste,\n",
        "        y_previsto\n",
        "    )\n",
        ")\n",
        "\n",
        "# R² = coeficiente de determinação.\n",
        "r2 = r2_score(\n",
        "    y_teste,\n",
        "    y_previsto\n",
        ")\n",
        "\n",
        "# WAPE = soma dos erros absolutos dividida\n",
        "# pela soma dos valores absolutos observados.\n",
        "\n",
        "denominador = np.abs(y_teste).sum()\n",
        "\n",
        "wape = (\n",
        "    np.abs(y_teste - y_previsto).sum()\n",
        "    / denominador * 100\n",
        "    if denominador > 0\n",
        "    else np.nan\n",
        ")\n",
        "\n",
        "print(\"\\nRESULTADOS DO TESTE FINAL:\")\n",
        "\n",
        "print(\"MAE:\", round(mae, 4))\n",
        "print(\"RMSE:\", round(rmse, 4))\n",
        "print(\"R²:\", round(r2, 4))\n",
        "print(\"WAPE (%):\", round(wape, 2))\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 22 - GRÁFICO COMPARATIVO DOS ALGORITMOS\n",
        "# ============================================================\n",
        "\n",
        "plt.figure(figsize=(10, 5))\n",
        "\n",
        "plt.bar(\n",
        "    comparacao[\"Algoritmo\"],\n",
        "    comparacao[\"RMSE_medio\"]\n",
        ")\n",
        "\n",
        "plt.ylabel(\"RMSE médio na validação\")\n",
        "plt.xlabel(\"Algoritmo\")\n",
        "plt.title(\"Comparação dos modelos de regressão\")\n",
        "\n",
        "plt.xticks(rotation=20)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 23 - COMPARAR VENDAS REAIS E PREVISTAS\n",
        "# ============================================================\n",
        "\n",
        "plt.figure(figsize=(8, 6))\n",
        "\n",
        "plt.scatter(\n",
        "    y_teste,\n",
        "    y_previsto,\n",
        "    alpha=0.45\n",
        ")\n",
        "\n",
        "menor = min(\n",
        "    y_teste.min(),\n",
        "    y_previsto.min()\n",
        ")\n",
        "\n",
        "maior = max(\n",
        "    y_teste.max(),\n",
        "    y_previsto.max()\n",
        ")\n",
        "\n",
        "# Linha de previsão perfeita.\n",
        "plt.plot(\n",
        "    [menor, maior],\n",
        "    [menor, maior],\n",
        "    \"r--\",\n",
        "    label=\"Previsão perfeita\"\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Valor real da venda\")\n",
        "plt.ylabel(\"Valor previsto da venda\")\n",
        "\n",
        "plt.title(\n",
        "    \"Valores reais versus valores previstos\"\n",
        ")\n",
        "\n",
        "plt.legend()\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 24 - ANÁLISE DOS RESÍDUOS\n",
        "# ============================================================\n",
        "\n",
        "# Resíduo = valor real - valor previsto.\n",
        "#\n",
        "# Se o valor é positivo:\n",
        "# o modelo subestimou a venda.\n",
        "#\n",
        "# Se o valor é negativo:\n",
        "# o modelo superestimou a venda.\n",
        "\n",
        "residuos = y_teste - y_previsto\n",
        "\n",
        "print(\"\\nESTATÍSTICA DESCRITIVA DOS RESÍDUOS:\")\n",
        "\n",
        "display(\n",
        "    pd.Series(residuos).describe()\n",
        ")\n",
        "\n",
        "# Histograma dos resíduos\n",
        "\n",
        "plt.figure(figsize=(10, 5))\n",
        "\n",
        "plt.hist(\n",
        "    residuos,\n",
        "    bins=40,\n",
        "    edgecolor=\"black\"\n",
        ")\n",
        "\n",
        "plt.axvline(\n",
        "    0,\n",
        "    color=\"red\",\n",
        "    linestyle=\"--\"\n",
        ")\n",
        "\n",
        "plt.title(\"Distribuição dos resíduos\")\n",
        "plt.xlabel(\"Resíduo\")\n",
        "plt.ylabel(\"Frequência\")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# Resíduos versus valores previstos\n",
        "\n",
        "plt.figure(figsize=(10, 5))\n",
        "\n",
        "plt.scatter(\n",
        "    y_previsto,\n",
        "    residuos,\n",
        "    alpha=0.45\n",
        ")\n",
        "\n",
        "plt.axhline(\n",
        "    0,\n",
        "    color=\"red\",\n",
        "    linestyle=\"--\"\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Valor previsto\")\n",
        "plt.ylabel(\"Resíduo\")\n",
        "plt.title(\"Resíduos versus previsões\")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 25 - ANALISAR OS COEFICIENTES\n",
        "# ============================================================\n",
        "\n",
        "# Como os modelos são lineares, é possível verificar\n",
        "# os coeficientes associados a cada variável após\n",
        "# o pré-processamento.\n",
        "\n",
        "nomes_variaveis = (\n",
        "    melhor_pipeline\n",
        "    .named_steps[\"preprocessamento\"]\n",
        "    .get_feature_names_out()\n",
        ")\n",
        "\n",
        "coeficientes = (\n",
        "    melhor_pipeline\n",
        "    .named_steps[\"modelo\"]\n",
        "    .coef_\n",
        ")\n",
        "\n",
        "tabela_coeficientes = pd.DataFrame({\n",
        "    \"Variável transformada\": nomes_variaveis,\n",
        "    \"Coeficiente\": coeficientes\n",
        "})\n",
        "\n",
        "tabela_coeficientes[\"Valor_absoluto\"] = (\n",
        "    tabela_coeficientes[\"Coeficiente\"].abs()\n",
        ")\n",
        "\n",
        "tabela_coeficientes = (\n",
        "    tabela_coeficientes\n",
        "    .sort_values(\n",
        "        \"Valor_absoluto\",\n",
        "        ascending=False\n",
        "    )\n",
        ")\n",
        "\n",
        "print(\"\\nCOEFICIENTES DO MELHOR MODELO:\")\n",
        "\n",
        "display(\n",
        "    tabela_coeficientes.drop(\n",
        "        columns=\"Valor_absoluto\"\n",
        "    )\n",
        ")\n",
        "\n",
        "# Atenção:\n",
        "# Os coeficientes numéricos correspondem às\n",
        "# variáveis padronizadas.\n",
        "#\n",
        "# Coeficientes não demonstram causalidade.\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 26 - VERIFICAR A FÓRMULA COMERCIAL\n",
        "# ============================================================\n",
        "\n",
        "# Em muitos sistemas:\n",
        "#\n",
        "# Valor da venda =\n",
        "# Preço unitário * Quantidade *\n",
        "# (1 - Desconto percentual / 100)\n",
        "#\n",
        "# Vamos verificar se essa fórmula se aproxima\n",
        "# do Sales_Amount registrado.\n",
        "#\n",
        "# Este é um diagnóstico separado dos modelos.\n",
        "# Não altera a seleção do algoritmo.\n",
        "\n",
        "formula_venda = (\n",
        "    X_teste[\"Unit_Price\"]\n",
        "    * X_teste[\"Quantity\"]\n",
        "    * (\n",
        "        1 -\n",
        "        X_teste[\"Discount_Percentage\"] / 100\n",
        "    )\n",
        ")\n",
        "\n",
        "mascara_formula = (\n",
        "    formula_venda.notna() &\n",
        "    np.isfinite(formula_venda)\n",
        ")\n",
        "\n",
        "if mascara_formula.any():\n",
        "\n",
        "    real_formula = y_teste.loc[\n",
        "        mascara_formula\n",
        "    ]\n",
        "\n",
        "    previsto_formula = formula_venda.loc[\n",
        "        mascara_formula\n",
        "    ]\n",
        "\n",
        "    erro_formula = mean_absolute_error(\n",
        "        real_formula,\n",
        "        previsto_formula\n",
        "    )\n",
        "\n",
        "    print(\"\\nVERIFICAÇÃO DA FÓRMULA COMERCIAL:\")\n",
        "\n",
        "    print(\n",
        "        \"MAE da fórmula:\",\n",
        "        round(erro_formula, 4)\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        \"Registros verificados:\",\n",
        "        int(mascara_formula.sum())\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        \"Esta verificação não substitui \"\n",
        "        \"a avaliação do modelo escolhido.\"\n",
        "    )\n",
        "\n",
        "else:\n",
        "    print(\n",
        "        \"\\nNão há observações suficientes \"\n",
        "        \"para verificar a fórmula comercial.\"\n",
        "    )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 27 - GERAR TABELA DE PREVISÕES\n",
        "# ============================================================\n",
        "\n",
        "# Organizar os resultados do teste em uma tabela.\n",
        "\n",
        "tabela_previsoes = X_teste.copy()\n",
        "\n",
        "tabela_previsoes[\"Venda_Real\"] = (\n",
        "    y_teste\n",
        ")\n",
        "\n",
        "tabela_previsoes[\"Venda_Prevista\"] = (\n",
        "    y_previsto\n",
        ")\n",
        "\n",
        "tabela_previsoes[\"Residuo\"] = (\n",
        "    y_teste - y_previsto\n",
        ")\n",
        "\n",
        "tabela_previsoes[\"Erro_Absoluto\"] = (\n",
        "    np.abs(y_teste - y_previsto)\n",
        ")\n",
        "\n",
        "print(\"\\nAMOSTRA DAS PREVISÕES:\")\n",
        "\n",
        "display(\n",
        "    tabela_previsoes.head(20)\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 28 - EXPORTAR OS RESULTADOS PARA EXCEL\n",
        "# ============================================================\n",
        "\n",
        "nome_relatorio = (\n",
        "    \"Resultado_Machine_Learning_Vendas.xlsx\"\n",
        ")\n",
        "\n",
        "metricas_finais = pd.DataFrame({\n",
        "    \"Indicador\": [\n",
        "        \"Melhor algoritmo\",\n",
        "        \"MAE\",\n",
        "        \"RMSE\",\n",
        "        \"R²\",\n",
        "        \"WAPE (%)\"\n",
        "    ],\n",
        "    \"Resultado\": [\n",
        "        melhor_algoritmo,\n",
        "        mae,\n",
        "        rmse,\n",
        "        r2,\n",
        "        wape\n",
        "    ]\n",
        "})\n",
        "\n",
        "with pd.ExcelWriter(\n",
        "    nome_relatorio,\n",
        "    engine=\"openpyxl\"\n",
        ") as writer:\n",
        "\n",
        "    comparacao.to_excel(\n",
        "        writer,\n",
        "        sheet_name=\"Comparacao_Modelos\",\n",
        "        index=False\n",
        "    )\n",
        "\n",
        "    metricas_finais.to_excel(\n",
        "        writer,\n",
        "        sheet_name=\"Metricas_Teste\",\n",
        "        index=False\n",
        "    )\n",
        "\n",
        "    tabela_coeficientes.drop(\n",
        "        columns=\"Valor_absoluto\"\n",
        "    ).to_excel(\n",
        "        writer,\n",
        "        sheet_name=\"Coeficientes\",\n",
        "        index=False\n",
        "    )\n",
        "\n",
        "    tabela_previsoes.to_excel(\n",
        "        writer,\n",
        "        sheet_name=\"Previsoes\",\n",
        "        index=False\n",
        "    )\n",
        "\n",
        "print(\"\\nRELATÓRIO EXCEL GERADO!\")\n",
        "\n",
        "files.download(nome_relatorio)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 29 - CONCLUSÃO\n",
        "# ============================================================\n",
        "\n",
        "print(\"\\n====================================\")\n",
        "print(\"ANÁLISE FINALIZADA\")\n",
        "print(\"====================================\")\n",
        "\n",
        "print(\"Melhor algoritmo:\", melhor_algoritmo)\n",
        "\n",
        "print(\"RMSE no teste:\", round(rmse, 4))\n",
        "\n",
        "print(\"R² no teste:\", round(r2, 4))\n",
        "\n",
        "print(\"\\nO DATASET ORIGINAL FOI PRESERVADO.\")\n",
        "\n",
        "print(\n",
        "    \"A seleção dos modelos foi realizada \"\n",
        "    \"somente nos dados de desenvolvimento.\"\n",
        ")\n"
      ],
