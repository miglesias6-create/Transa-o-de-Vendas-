    {
      "cell_type": "code",
      "source": [
        "\n",
        "# ============================================================\n",
        "# PREVISÃO DE VENDAS: LINEAR, LASSO, RIDGE E ELASTIC NET\n",
        "# Estratégias: exclusão, mediana e KNN\n",
        "# Google Colab | não altera o Excel original\n",
        "# ============================================================\n",
        "\n",
        "import os\n",
        "import warnings\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "from sklearn.base import BaseEstimator, TransformerMixin\n",
        "from sklearn.compose import ColumnTransformer\n",
        "from sklearn.impute import SimpleImputer, KNNImputer\n",
        "from sklearn.linear_model import LinearRegression, Lasso, Ridge, ElasticNet\n",
        "from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score\n",
        "from sklearn.model_selection import train_test_split, KFold\n",
        "from sklearn.pipeline import Pipeline\n",
        "from sklearn.preprocessing import OneHotEncoder, StandardScaler\n",
        "from sklearn.exceptions import ConvergenceWarning\n",
        "\n",
        "warnings.filterwarnings('ignore', category=ConvergenceWarning)\n",
        "\n",
        "SEMENTE = 42\n",
        "ALVO = 'Sales_Amount'\n",
        "\n",
        "NUMERICAS = [\n",
        "    'Customer_Age',\n",
        "    'Unit_Price',\n",
        "    'Quantity',\n",
        "    'Discount_Percentage',\n",
        "    'Customer_Rating'\n",
        "]\n",
        "\n",
        "CATEGORICAS = [\n",
        "    'Customer_Segment',\n",
        "    'Sales_Channel',\n",
        "    'Product_Category'\n",
        "]\n",
        "\n",
        "PREDITORES = NUMERICAS + CATEGORICAS\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 1 - CAMINHO DO ARQUIVO\n",
        "#\n",
        "# ALTERE SOMENTE A LINHA ABAIXO PARA SEU GOOGLE DRIVE.\n",
        "# ============================================================\n",
        "\n",
        "CAMINHO_ARQUIVO = \"/content/drive/MyDrive/Banco de Dados 1/Sales_transactions_2022_2025.xlsx\"\n",
        "\n",
        "# ============================================================\n",
        "# FIM DA PARTE QUE VOCÊ PRECISA ALTERAR\n",
        "# ============================================================\n",
        "\n",
        "\n",
        "# ETAPA 2 - CONECTAR O GOOGLE DRIVE\n",
        "\n",
        "try:\n",
        "    from google.colab import drive, files\n",
        "    drive.mount('/content/drive')\n",
        "    NO_COLAB = True\n",
        "except ImportError:\n",
        "    NO_COLAB = False\n",
        "\n",
        "if not os.path.isfile(CAMINHO_ARQUIVO):\n",
        "    raise FileNotFoundError(\n",
        "        'Confira o CAMINHO_ARQUIVO: ' + CAMINHO_ARQUIVO\n",
        "    )\n",
        "\n",
        "\n",
        "# ETAPA 3 - LER OS DADOS SEM ALTERAR O ORIGINAL\n",
        "\n",
        "df_original = pd.read_excel(CAMINHO_ARQUIVO)\n",
        "\n",
        "faltantes = sorted(\n",
        "    set(PREDITORES + [ALVO]) -\n",
        "    set(df_original.columns)\n",
        ")\n",
        "\n",
        "if faltantes:\n",
        "    raise ValueError(\n",
        "        'Colunas não encontradas: ' + str(faltantes)\n",
        "    )\n",
        "\n",
        "dados = df_original[\n",
        "    PREDITORES + [ALVO]\n",
        "].copy(deep=True)\n",
        "\n",
        "for c in NUMERICAS + [ALVO]:\n",
        "    dados[c] = pd.to_numeric(\n",
        "        dados[c], errors='coerce'\n",
        "    )\n",
        "    dados[c] = dados[c].replace(\n",
        "        [np.inf, -np.inf], np.nan\n",
        "    )\n",
        "\n",
        "for c in CATEGORICAS:\n",
        "    dados[c] = (\n",
        "        dados[c]\n",
        "        .astype('string')\n",
        "        .str.strip()\n",
        "        .str.lower()\n",
        "    )\n",
        "    dados[c] = (\n",
        "        dados[c]\n",
        "        .replace('', pd.NA)\n",
        "        .astype(object)\n",
        "    )\n",
        "    dados[c] = dados[c].where(\n",
        "        pd.notna(dados[c]), np.nan\n",
        "    )\n",
        "\n",
        "# A variável dependente precisa ter valor conhecido.\n",
        "dados = dados.dropna(subset=[ALVO]).copy()\n",
        "\n",
        "X = dados[PREDITORES]\n",
        "y = dados[ALVO]\n",
        "\n",
        "print(\"Dataset original:\", df_original.shape)\n",
        "print(\"Dataset de modelagem:\", dados.shape)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 4 - REGRAS DE PLAUSIBILIDADE\n",
        "# ============================================================\n",
        "\n",
        "# Hipóteses adotadas:\n",
        "#\n",
        "# Idade: 18 a 120 anos, supondo comprador adulto.\n",
        "# Preço: maior que zero.\n",
        "# Quantidade: inteiro positivo.\n",
        "# Desconto: entre 0 e 100%.\n",
        "# Avaliação: entre 1 e 5.\n",
        "#\n",
        "# Os critérios são hipóteses operacionais do estudo.\n",
        "\n",
        "def regras_invalidas(X):\n",
        "\n",
        "    a = pd.DataFrame(\n",
        "        False,\n",
        "        index=X.index,\n",
        "        columns=[\n",
        "            'Idade',\n",
        "            'Preco',\n",
        "            'Quantidade',\n",
        "            'Desconto',\n",
        "            'Avaliacao'\n",
        "        ]\n",
        "    )\n",
        "\n",
        "    idade, preco, qtd, desc, nota = [\n",
        "        pd.to_numeric(X[c], errors='coerce')\n",
        "        for c in NUMERICAS\n",
        "    ]\n",
        "\n",
        "    a['Idade'] = (\n",
        "        (idade < 18) | (idade > 120)\n",
        "    ).fillna(False)\n",
        "\n",
        "    a['Preco'] = (\n",
        "        preco <= 0\n",
        "    ).fillna(False)\n",
        "\n",
        "    a['Quantidade'] = (\n",
        "        (qtd <= 0) |\n",
        "        (\n",
        "            qtd.notna() &\n",
        "            (qtd != np.floor(qtd))\n",
        "        )\n",
        "    ).fillna(False)\n",
        "\n",
        "    a['Desconto'] = (\n",
        "        (desc < 0) | (desc > 100)\n",
        "    ).fillna(False)\n",
        "\n",
        "    a['Avaliacao'] = (\n",
        "        (nota < 1) | (nota > 5)\n",
        "    ).fillna(False)\n",
        "\n",
        "    return a\n",
        "\n",
        "\n",
        "# ETAPA 5 - DIAGNÓSTICO INICIAL\n",
        "\n",
        "qualidade = regras_invalidas(X)\n",
        "\n",
        "print(\"\\nINCONSISTÊNCIAS ENCONTRADAS:\")\n",
        "display(\n",
        "    qualidade.sum().to_frame('Ocorrencias')\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Registros com alguma inconsistência:\",\n",
        "    int(qualidade.any(axis=1).sum())\n",
        ")\n",
        "\n",
        "print(\"\\nVALORES AUSENTES:\")\n",
        "display(\n",
        "    X.isna().sum().to_frame('Ausentes')\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 6 - TRANSFORMADOR DE PLAUSIBILIDADE\n",
        "# ============================================================\n",
        "\n",
        "# O transformador converte valores inválidos em NaN.\n",
        "# Não modifica os dados recebidos.\n",
        "\n",
        "class ValidarNumericos(BaseEstimator, TransformerMixin):\n",
        "\n",
        "    def fit(self, X, y=None):\n",
        "        return self\n",
        "\n",
        "    def transform(self, X):\n",
        "\n",
        "        arr = np.asarray(\n",
        "            X, dtype=float\n",
        "        ).copy()\n",
        "\n",
        "        arr[~np.isfinite(arr)] = np.nan\n",
        "\n",
        "        idade, preco, qtd, desc, nota = [\n",
        "            arr[:, i] for i in range(5)\n",
        "        ]\n",
        "\n",
        "        idade[\n",
        "            (idade < 18) | (idade > 120)\n",
        "        ] = np.nan\n",
        "\n",
        "        preco[\n",
        "            preco <= 0\n",
        "        ] = np.nan\n",
        "\n",
        "        qtd[\n",
        "            (qtd <= 0) |\n",
        "            (\n",
        "                np.isfinite(qtd) &\n",
        "                (qtd != np.floor(qtd))\n",
        "            )\n",
        "        ] = np.nan\n",
        "\n",
        "        desc[\n",
        "            (desc < 0) | (desc > 100)\n",
        "        ] = np.nan\n",
        "\n",
        "        nota[\n",
        "            (nota < 1) | (nota > 5)\n",
        "        ] = np.nan\n",
        "\n",
        "        return arr\n",
        "\n",
        "    def get_feature_names_out(\n",
        "        self, input_features=None\n",
        "    ):\n",
        "\n",
        "        return np.asarray(\n",
        "            input_features\n",
        "            if input_features is not None\n",
        "            else NUMERICAS,\n",
        "            dtype=object\n",
        "        )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 7 - PIPELINES DE PRÉ-PROCESSAMENTO\n",
        "# ============================================================\n",
        "\n",
        "def montar_preprocessador(estrategia, k=5):\n",
        "\n",
        "    if estrategia == 'KNN':\n",
        "\n",
        "        # Padronização antes do cálculo\n",
        "        # de distância entre vizinhos.\n",
        "\n",
        "        num = Pipeline([\n",
        "            (\n",
        "                'validacao',\n",
        "                ValidarNumericos()\n",
        "            ),\n",
        "            (\n",
        "                'escala_pre_knn',\n",
        "                StandardScaler()\n",
        "            ),\n",
        "            (\n",
        "                'imputacao',\n",
        "                KNNImputer(\n",
        "                    n_neighbors=k,\n",
        "                    weights='distance'\n",
        "                )\n",
        "            )\n",
        "        ])\n",
        "\n",
        "    else:\n",
        "\n",
        "        num = Pipeline([\n",
        "            (\n",
        "                'validacao',\n",
        "                ValidarNumericos()\n",
        "            ),\n",
        "            (\n",
        "                'imputacao',\n",
        "                SimpleImputer(\n",
        "                    strategy='median'\n",
        "                )\n",
        "            ),\n",
        "            (\n",
        "                'escala',\n",
        "                StandardScaler()\n",
        "            )\n",
        "        ])\n",
        "\n",
        "    cat = Pipeline([\n",
        "        (\n",
        "            'imputacao',\n",
        "            SimpleImputer(\n",
        "                strategy='most_frequent'\n",
        "            )\n",
        "        ),\n",
        "        (\n",
        "            'onehot',\n",
        "            OneHotEncoder(\n",
        "                handle_unknown='ignore'\n",
        "            )\n",
        "        )\n",
        "    ])\n",
        "\n",
        "    return ColumnTransformer([\n",
        "        (\n",
        "            'numericas',\n",
        "            num,\n",
        "            NUMERICAS\n",
        "        ),\n",
        "        (\n",
        "            'categoricas',\n",
        "            cat,\n",
        "            CATEGORICAS\n",
        "        )\n",
        "    ])\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 8 - SEPARAÇÃO TREINAMENTO E TESTE\n",
        "# ============================================================\n",
        "\n",
        "X_dev, X_teste_bruto, y_dev, y_teste_bruto = (\n",
        "    train_test_split(\n",
        "        X,\n",
        "        y,\n",
        "        test_size=0.20,\n",
        "        random_state=SEMENTE\n",
        "    )\n",
        ")\n",
        "\n",
        "# Mesmo conjunto de teste para todas as estratégias.\n",
        "# Aplicamos somente regras objetivas de plausibilidade.\n",
        "# Nenhum parâmetro estatístico é aprendido no teste.\n",
        "\n",
        "validos_teste = (\n",
        "    ~regras_invalidas(\n",
        "        X_teste_bruto\n",
        "    ).any(axis=1)\n",
        ")\n",
        "\n",
        "X_teste = X_teste_bruto.loc[\n",
        "    validos_teste\n",
        "].copy()\n",
        "\n",
        "y_teste = y_teste_bruto.loc[\n",
        "    validos_teste\n",
        "].copy()\n",
        "\n",
        "if len(X_teste) == 0:\n",
        "    raise ValueError(\n",
        "        'Não há registros válidos no teste.'\n",
        "    )\n",
        "\n",
        "print(\"\\nDIVISÃO DOS DADOS:\")\n",
        "print(\"Desenvolvimento:\", len(X_dev))\n",
        "print(\"Teste comum:\", len(X_teste))\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 9 - VALIDAÇÃO CRUZADA K-FOLD\n",
        "# ============================================================\n",
        "\n",
        "dobras = list(\n",
        "    KFold(\n",
        "        n_splits=5,\n",
        "        shuffle=True,\n",
        "        random_state=SEMENTE\n",
        "    ).split(X_dev)\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 10 - ALGORITMOS E HIPERPARÂMETROS\n",
        "# ============================================================\n",
        "\n",
        "configs = [\n",
        "    ('Linear', {})\n",
        "]\n",
        "\n",
        "configs += [\n",
        "    ('Lasso', {'alpha': a})\n",
        "    for a in (0.01, 0.1, 1.0)\n",
        "]\n",
        "\n",
        "configs += [\n",
        "    ('Ridge', {'alpha': a})\n",
        "    for a in (0.01, 1.0, 100.0)\n",
        "]\n",
        "\n",
        "configs += [\n",
        "    (\n",
        "        'ElasticNet',\n",
        "        {'alpha': a, 'l1_ratio': r}\n",
        "    )\n",
        "    for a in (0.01, 0.1)\n",
        "    for r in (0.2, 0.5, 0.8)\n",
        "]\n",
        "\n",
        "\n",
        "def criar_modelo(nome, params):\n",
        "\n",
        "    if nome == 'Linear':\n",
        "        return LinearRegression()\n",
        "\n",
        "    if nome == 'Lasso':\n",
        "        return Lasso(\n",
        "            max_iter=50000,\n",
        "            random_state=SEMENTE,\n",
        "            **params\n",
        "        )\n",
        "\n",
        "    if nome == 'Ridge':\n",
        "        return Ridge(**params)\n",
        "\n",
        "    return ElasticNet(\n",
        "        max_iter=50000,\n",
        "        random_state=SEMENTE,\n",
        "        **params\n",
        "    )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 11 - COMPARAR EXCLUSÃO, MEDIANA E KNN\n",
        "# ============================================================\n",
        "\n",
        "estrategias = (\n",
        "    'Exclusao',\n",
        "    'Mediana',\n",
        "    'KNN'\n",
        ")\n",
        "\n",
        "resultados_cv = []\n",
        "\n",
        "for estrategia in estrategias:\n",
        "\n",
        "    print(\"\\nVALIDAÇÃO:\", estrategia)\n",
        "\n",
        "    scores = {\n",
        "        (\n",
        "            nome,\n",
        "            tuple(sorted(p.items()))\n",
        "        ): []\n",
        "        for nome, p in configs\n",
        "    }\n",
        "\n",
        "    for n, (it, iv) in enumerate(dobras, 1):\n",
        "\n",
        "        Xt = X_dev.iloc[it].copy()\n",
        "        Xv = X_dev.iloc[iv].copy()\n",
        "\n",
        "        yt = y_dev.iloc[it].copy()\n",
        "        yv = y_dev.iloc[iv].copy()\n",
        "\n",
        "        # Exclusão apenas no treinamento\n",
        "        # da dobra, na estratégia correspondente.\n",
        "\n",
        "        if estrategia == 'Exclusao':\n",
        "\n",
        "            manter = (\n",
        "                ~regras_invalidas(\n",
        "                    Xt\n",
        "                ).any(axis=1)\n",
        "            )\n",
        "\n",
        "            Xt = Xt.loc[manter]\n",
        "            yt = yt.loc[manter]\n",
        "\n",
        "        # Todas as estratégias serão avaliadas\n",
        "        # sobre os mesmos registros de validação.\n",
        "\n",
        "        valido = (\n",
        "            ~regras_invalidas(\n",
        "                Xv\n",
        "            ).any(axis=1)\n",
        "        )\n",
        "\n",
        "        Xv = Xv.loc[valido]\n",
        "        yv = yv.loc[valido]\n",
        "\n",
        "        if len(Xv) == 0:\n",
        "            raise ValueError(\n",
        "                'Dobra de validação sem casos válidos.'\n",
        "            )\n",
        "\n",
        "        # Ajustar o preprocessamento APENAS\n",
        "        # nos dados de treinamento da dobra.\n",
        "\n",
        "        prep = montar_preprocessador(\n",
        "            estrategia\n",
        "        )\n",
        "\n",
        "        Xt_p = prep.fit_transform(Xt)\n",
        "        Xv_p = prep.transform(Xv)\n",
        "\n",
        "        for nome, params in configs:\n",
        "\n",
        "            modelo = criar_modelo(\n",
        "                nome, params\n",
        "            )\n",
        "\n",
        "            modelo.fit(Xt_p, yt)\n",
        "\n",
        "            pred = modelo.predict(Xv_p)\n",
        "\n",
        "            rmse = np.sqrt(\n",
        "                mean_squared_error(\n",
        "                    yv, pred\n",
        "                )\n",
        "            )\n",
        "\n",
        "            chave = (\n",
        "                nome,\n",
        "                tuple(sorted(params.items()))\n",
        "            )\n",
        "\n",
        "            scores[chave].append(rmse)\n",
        "\n",
        "        print(\n",
        "            f'Dobra {n}/5 concluída'\n",
        "        )\n",
        "\n",
        "    for (nome, pp), vals in scores.items():\n",
        "\n",
        "        resultados_cv.append({\n",
        "            'Estrategia': estrategia,\n",
        "            'Algoritmo': nome,\n",
        "            'Parametros': dict(pp),\n",
        "            'RMSE_CV': np.mean(vals),\n",
        "            'Desvio_RMSE': np.std(\n",
        "                vals, ddof=1\n",
        "            )\n",
        "        })\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 12 - COMPARAÇÃO DOS MODELOS\n",
        "# ============================================================\n",
        "\n",
        "cv = pd.DataFrame(\n",
        "    resultados_cv\n",
        ").sort_values(\n",
        "    'RMSE_CV'\n",
        ").reset_index(drop=True)\n",
        "\n",
        "melhores_por_algoritmo = (\n",
        "    cv.drop_duplicates([\n",
        "        'Estrategia',\n",
        "        'Algoritmo'\n",
        "    ])\n",
        ")\n",
        "\n",
        "melhores_por_estrategia = (\n",
        "    cv.drop_duplicates(\n",
        "        'Estrategia'\n",
        "    )\n",
        ")\n",
        "\n",
        "print(\"\\nMELHOR CONFIGURAÇÃO DE CADA ALGORITMO:\")\n",
        "\n",
        "display(melhores_por_algoritmo)\n",
        "\n",
        "print(\"\\nMELHOR CONFIGURAÇÃO DE CADA ESTRATÉGIA:\")\n",
        "\n",
        "display(melhores_por_estrategia)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 13 - SELECIONAR O MELHOR MODELO\n",
        "# ============================================================\n",
        "\n",
        "# A escolha utiliza exclusivamente o RMSE\n",
        "# da validação cruzada, não o teste final.\n",
        "\n",
        "campeao = cv.iloc[0]\n",
        "\n",
        "print(\"\\nMODELO VENCEDOR:\")\n",
        "\n",
        "print(\"Estratégia:\", campeao['Estrategia'])\n",
        "print(\"Algoritmo:\", campeao['Algoritmo'])\n",
        "print(\"Parâmetros:\", campeao['Parametros'])\n",
        "print(\"RMSE-CV:\", round(campeao['RMSE_CV'], 4))\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 14 - AJUSTAR O MODELO FINAL\n",
        "# ============================================================\n",
        "\n",
        "def ajustar_final(\n",
        "    estrategia,\n",
        "    nome,\n",
        "    params\n",
        "):\n",
        "\n",
        "    Xt = X_dev.copy()\n",
        "    yt = y_dev.copy()\n",
        "\n",
        "    if estrategia == 'Exclusao':\n",
        "\n",
        "        manter = (\n",
        "            ~regras_invalidas(\n",
        "                Xt\n",
        "            ).any(axis=1)\n",
        "        )\n",
        "\n",
        "        Xt = Xt.loc[manter]\n",
        "        yt = yt.loc[manter]\n",
        "\n",
        "    prep = montar_preprocessador(\n",
        "        estrategia\n",
        "    )\n",
        "\n",
        "    Xt_p = prep.fit_transform(Xt)\n",
        "\n",
        "    reg = criar_modelo(\n",
        "        nome, params\n",
        "    )\n",
        "\n",
        "    reg.fit(Xt_p, yt)\n",
        "\n",
        "    return prep, reg, len(Xt)\n",
        "\n",
        "\n",
        "prep_final, reg_final, n_final = ajustar_final(\n",
        "    campeao['Estrategia'],\n",
        "    campeao['Algoritmo'],\n",
        "    campeao['Parametros']\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 15 - AVALIAÇÃO DO TESTE FINAL\n",
        "# ============================================================\n",
        "\n",
        "pred_final = reg_final.predict(\n",
        "    prep_final.transform(X_teste)\n",
        ")\n",
        "\n",
        "metricas = pd.DataFrame([{\n",
        "    'Estrategia': campeao['Estrategia'],\n",
        "    'Algoritmo': campeao['Algoritmo'],\n",
        "    'Treino_efetivo': n_final,\n",
        "    'N_teste': len(X_teste),\n",
        "    'RMSE_CV': campeao['RMSE_CV'],\n",
        "    'MAE_Teste': mean_absolute_error(\n",
        "        y_teste, pred_final\n",
        "    ),\n",
        "    'RMSE_Teste': np.sqrt(\n",
        "        mean_squared_error(\n",
        "            y_teste, pred_final\n",
        "        )\n",
        "    ),\n",
        "    'R2_Teste': r2_score(\n",
        "        y_teste, pred_final\n",
        "    )\n",
        "}])\n",
        "\n",
        "print(\"\\nAVALIAÇÃO FINAL:\")\n",
        "display(metricas)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 16 - COEFICIENTES DA REGRESSÃO LASSO\n",
        "#\n",
        "# ESTA É A ANÁLISE QUE VOCÊ SOLICITOU.\n",
        "# ============================================================\n",
        "\n",
        "# Os coeficientes serão extraídos do melhor\n",
        "# Lasso de cada estratégia, mesmo quando\n",
        "# outro algoritmo vencer a comparação geral.\n",
        "\n",
        "coef_lasso = []\n",
        "resumo_lasso = []\n",
        "\n",
        "for estrategia in estrategias:\n",
        "\n",
        "    linha = melhores_por_algoritmo.loc[\n",
        "        (\n",
        "            melhores_por_algoritmo['Estrategia']\n",
        "            == estrategia\n",
        "        ) &\n",
        "        (\n",
        "            melhores_por_algoritmo['Algoritmo']\n",
        "            == 'Lasso'\n",
        "        )\n",
        "    ].iloc[0]\n",
        "\n",
        "    prep, reg, n_util = ajustar_final(\n",
        "        estrategia,\n",
        "        'Lasso',\n",
        "        linha['Parametros']\n",
        "    )\n",
        "\n",
        "    # Obter os nomes após One-Hot Encoding.\n",
        "\n",
        "    nomes = prep.get_feature_names_out()\n",
        "\n",
        "    # Extrair coeficientes do Lasso.\n",
        "\n",
        "    tab = pd.DataFrame({\n",
        "        'Estrategia': estrategia,\n",
        "        'Variavel_Transformada': nomes,\n",
        "        'Coeficiente': reg.coef_\n",
        "    })\n",
        "\n",
        "    # Calcular valor absoluto para ordenação.\n",
        "\n",
        "    tab['Magnitude_Absoluta'] = (\n",
        "        tab['Coeficiente'].abs()\n",
        "    )\n",
        "\n",
        "    # Identificar os coeficientes zerados.\n",
        "\n",
        "    tab['Situacao'] = np.where(\n",
        "        np.isclose(\n",
        "            tab['Coeficiente'],\n",
        "            0.0,\n",
        "            atol=1e-8\n",
        "        ),\n",
        "        'Zerado',\n",
        "        'Mantido'\n",
        "    )\n",
        "\n",
        "    tab = tab.sort_values(\n",
        "        'Magnitude_Absoluta',\n",
        "        ascending=False\n",
        "    )\n",
        "\n",
        "    coef_lasso.append(tab)\n",
        "\n",
        "    resumo_lasso.append({\n",
        "        'Estrategia': estrategia,\n",
        "        'Alpha_Lasso': linha['Parametros']['alpha'],\n",
        "        'Intercepto': reg.intercept_,\n",
        "        'N_treino': n_util,\n",
        "        'N_coeficientes': len(tab),\n",
        "        'N_zerados': int(\n",
        "            (tab['Situacao'] == 'Zerado').sum()\n",
        "        ),\n",
        "        'N_mantidos': int(\n",
        "            (tab['Situacao'] == 'Mantido').sum()\n",
        "        ),\n",
        "        'RMSE_CV': linha['RMSE_CV']\n",
        "    })\n",
        "\n",
        "    print(\n",
        "        \"\\nCOEFICIENTES DO LASSO -\",\n",
        "        estrategia\n",
        "    )\n",
        "\n",
        "    display(\n",
        "        tab[[\n",
        "            'Variavel_Transformada',\n",
        "            'Coeficiente',\n",
        "            'Magnitude_Absoluta',\n",
        "            'Situacao'\n",
        "        ]]\n",
        "    )\n",
        "\n",
        "    # GRÁFICO DOS COEFICIENTES\n",
        "\n",
        "    graf = tab.iloc[:20].sort_values(\n",
        "        'Coeficiente'\n",
        "    )\n",
        "\n",
        "    plt.figure(\n",
        "        figsize=(\n",
        "            11,\n",
        "            max(5, 0.38 * len(graf))\n",
        "        )\n",
        "    )\n",
        "\n",
        "    plt.barh(\n",
        "        graf['Variavel_Transformada'],\n",
        "        graf['Coeficiente']\n",
        "    )\n",
        "\n",
        "    plt.axvline(\n",
        "        0,\n",
        "        color='black',\n",
        "        linewidth=1\n",
        "    )\n",
        "\n",
        "    plt.title(\n",
        "        'Lasso - Coeficientes - ' +\n",
        "        estrategia\n",
        "    )\n",
        "\n",
        "    plt.xlabel(\n",
        "        'Coeficiente estimado'\n",
        "    )\n",
        "\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 17 - CONSOLIDAR COEFICIENTES\n",
        "# ============================================================\n",
        "\n",
        "coef_lasso = pd.concat(\n",
        "    coef_lasso,\n",
        "    ignore_index=True\n",
        ")\n",
        "\n",
        "resumo_lasso = pd.DataFrame(\n",
        "    resumo_lasso\n",
        ")\n",
        "\n",
        "print(\"\\nRESUMO DA REGRESSÃO LASSO:\")\n",
        "display(resumo_lasso)\n",
        "\n",
        "print(\"\\nTODOS OS COEFICIENTES:\")\n",
        "display(coef_lasso)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 18 - COMPARAÇÃO GRÁFICA DOS ALGORITMOS\n",
        "# ============================================================\n",
        "\n",
        "plt.figure(figsize=(10, 5))\n",
        "\n",
        "plot_cv = melhores_por_algoritmo.copy()\n",
        "\n",
        "plot_cv['Combinacao'] = (\n",
        "    plot_cv['Estrategia']\n",
        "    + ' / '\n",
        "    + plot_cv['Algoritmo']\n",
        ")\n",
        "\n",
        "plt.barh(\n",
        "    plot_cv['Combinacao'][::-1],\n",
        "    plot_cv['RMSE_CV'][::-1]\n",
        ")\n",
        "\n",
        "plt.xlabel(\n",
        "    'RMSE médio de validação'\n",
        ")\n",
        "\n",
        "plt.title(\n",
        "    'Comparação dos algoritmos e estratégias'\n",
        ")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 19 - VENDAS REAIS X PREVISTAS\n",
        "# ============================================================\n",
        "\n",
        "plt.figure(figsize=(6, 6))\n",
        "\n",
        "plt.scatter(\n",
        "    y_teste,\n",
        "    pred_final,\n",
        "    alpha=0.3\n",
        ")\n",
        "\n",
        "mn = min(\n",
        "    y_teste.min(),\n",
        "    pred_final.min()\n",
        ")\n",
        "\n",
        "mx = max(\n",
        "    y_teste.max(),\n",
        "    pred_final.max()\n",
        ")\n",
        "\n",
        "plt.plot(\n",
        "    [mn, mx],\n",
        "    [mn, mx],\n",
        "    'r--'\n",
        ")\n",
        "\n",
        "plt.xlabel('Vendas observadas')\n",
        "plt.ylabel('Vendas previstas')\n",
        "\n",
        "plt.title(\n",
        "    'Teste final: vendas reais x previstas'\n",
        ")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 20 - ANÁLISE DOS RESÍDUOS\n",
        "# ============================================================\n",
        "\n",
        "residuos = (\n",
        "    y_teste.to_numpy() - pred_final\n",
        ")\n",
        "\n",
        "plt.figure(figsize=(8, 4))\n",
        "\n",
        "plt.scatter(\n",
        "    pred_final,\n",
        "    residuos,\n",
        "    alpha=0.3\n",
        ")\n",
        "\n",
        "plt.axhline(\n",
        "    0,\n",
        "    color='red',\n",
        "    linestyle='--'\n",
        ")\n",
        "\n",
        "plt.xlabel('Previsão')\n",
        "plt.ylabel('Resíduo: real - previsto')\n",
        "\n",
        "plt.title(\n",
        "    'Análise dos resíduos'\n",
        ")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 21 - TABELA DE PREVISÕES\n",
        "# ============================================================\n",
        "\n",
        "prev = X_teste.copy()\n",
        "\n",
        "prev['Venda_Real'] = y_teste\n",
        "prev['Venda_Prevista'] = pred_final\n",
        "prev['Residuo'] = residuos\n",
        "\n",
        "prev['Erro_Absoluto'] = (\n",
        "    np.abs(residuos)\n",
        ")\n",
        "\n",
        "print(\"\\nAMOSTRA DAS PREVISÕES:\")\n",
        "display(prev.head(20))\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 22 - EXPORTAR RELATÓRIO PARA EXCEL\n",
        "# ============================================================\n",
        "\n",
        "saida = (\n",
        "    '/content/Relatorio_ML_Vendas_Lasso.xlsx'\n",
        "    if NO_COLAB\n",
        "    else 'Relatorio_ML_Vendas_Lasso.xlsx'\n",
        ")\n",
        "\n",
        "with pd.ExcelWriter(\n",
        "    saida,\n",
        "    engine='openpyxl'\n",
        ") as writer:\n",
        "\n",
        "    qualidade.sum().rename(\n",
        "        'Ocorrencias'\n",
        "    ).to_frame().to_excel(\n",
        "        writer,\n",
        "        sheet_name='Plausibilidade'\n",
        "    )\n",
        "\n",
        "    X.isna().rename(\n",
        "        'Ausentes'\n",
        "    ).to_frame().to_excel(\n",
        "        writer,\n",
        "        sheet_name='Missing'\n",
        "    )\n",
        "\n",
        "    cv.assign(\n",
        "        Parametros=cv['Parametros'].astype(str)\n",
        "    ).to_excel(\n",
        "        writer,\n",
        "        sheet_name='Todas_Configuracoes',\n",
        "        index=False\n",
        "    )\n",
        "\n",
        "    melhores_por_algoritmo.assign(\n",
        "        Parametros=melhores_por_algoritmo[\n",
        "            'Parametros'\n",
        "        ].astype(str)\n",
        "    ).to_excel(\n",
        "        writer,\n",
        "        sheet_name='Comparacao_Modelos',\n",
        "        index=False\n",
        "    )\n",
        "\n",
        "    metricas.to_excel(\n",
        "        writer,\n",
        "        sheet_name='Teste_Final',\n",
        "        index=False\n",
        "    )\n",
        "\n",
        "    resumo_lasso.to_excel(\n",
        "        writer,\n",
        "        sheet_name='Resumo_Lasso',\n",
        "        index=False\n",
        "    )\n",
        "\n",
        "    coef_lasso.to_excel(\n",
        "        writer,\n",
        "        sheet_name='Coeficientes_Lasso',\n",
        "        index=False\n",
        "    )\n",
        "\n",
        "    prev.to_excel(\n",
        "        writer,\n",
        "        sheet_name='Previsoes',\n",
        "        index=False\n",
        "    )\n",
        "\n",
        "print(\"\\nRELATÓRIO CRIADO:\", saida)\n",
        "\n",
        "print(\n",
        "    \"ARQUIVO ORIGINAL PRESERVADO:\",\n",
        "    CAMINHO_ARQUIVO\n",
        ")\n",
        "\n",
        "if NO_COLAB:\n",
        "    files.download(saida)\n",
        "\n",
        "print(\"\\nPROCESSAMENTO FINALIZADO!\")\n"
      ],
