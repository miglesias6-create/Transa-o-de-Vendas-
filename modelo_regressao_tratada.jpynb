            "text/html": [
              "\n",
              "  <div id=\"df-6b54c225-472c-4aa3-bd6b-97449811eefe\" class=\"colab-df-container\">\n",
              "    <div>\n",
              "<style scoped>\n",
              "    .dataframe tbody tr th:only-of-type {\n",
