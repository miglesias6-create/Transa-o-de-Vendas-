              "        dataTable['output_type'] = 'display_data';\n",
              "        await google.colab.output.renderOutput(dataTable, element);\n",
              "        const docLink = document.createElement('div');\n",
              "        docLink.innerHTML = docLinkHtml;\n",
              "        element.appendChild(docLink);\n",
              "      }\n",
              "    </script>\n",
              "  </div>\n",
              "\n",
              "\n",
              "    </div>\n",
              "  </div>\n"
            ],
            "application/vnd.google.colaboratory.intrinsic+json": {
              "type": "dataframe",
              "summary": "{\n  \"name\": \")\",\n  \"rows\": 20,\n  \"fields\": [\n    {\n      \"column\": \"Customer_Age\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 8.65280605535447,\n        \"min\": 27.0,\n        \"max\": 55.0,\n        \"num_unique_values\": 15,\n        \"samples\": [\n          29.0,\n          30.0,\n          52.0\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"Unit_Price\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 230.56231575672822,\n        \"min\": 29.14,\n        \"max\": 849.68,\n        \"num_unique_values\": 20,\n        \"samples\": [\n          51.26,\n          89.05,\n          849.68\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"Quantity\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 1,\n        \"min\": 1,\n        \"max\": 4,\n        \"num_unique_values\": 4,\n        \"samples\": [\n          1,\n          4,\n          3\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"Discount_Percentage\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 6.155870112510924,\n        \"min\": 0.0,\n        \"max\": 20.0,\n        \"num_unique_values\": 5,\n        \"samples\": [\n          10.0,\n          15.0,\n          5.0\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"Customer_Rating\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 1.3339459376998313,\n        \"min\": 1.0,\n        \"max\": 5.0,\n        \"num_unique_values\": 4,\n        \"samples\": [\n          4.0,\n          1.0,\n          5.0\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"Customer_Segment\",\n      \"properties\": {\n        \"dtype\": \"category\",\n        \"num_unique_values\": 6,\n        \"samples\": [\n          \"Consumer\",\n          \"Small Business\",\n          \"Premium\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"Sales_Channel\",\n      \"properties\": {\n        \"dtype\": \"category\",\n        \"num_unique_values\": 3,\n        \"samples\": [\n          \"Online\",\n          \"Retail Store\",\n          \"Phone Order\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"Product_Category\",\n      \"properties\": {\n        \"dtype\": \"category\",\n        \"num_unique_values\": 4,\n        \"samples\": [\n          \"Office Supplies\",\n          \"Appliances\",\n          \"Electronics\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"Venda_Real\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 406.3329505567545,\n        \"min\": 40.65,\n        \"max\": 1489.94,\n        \"num_unique_values\": 20,\n        \"samples\": [\n          153.79,\n          75.69,\n          722.23\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"Venda_Prevista\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 475.6750330723293,\n        \"min\": -156.04911123067524,\n        \"max\": 1378.4099541616258,\n        \"num_unique_values\": 20,\n        \"samples\": [\n          317.68595582190653,\n          -98.18658135534002,\n          1378.4099541616258\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"Residuo\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 229.0398047771575,\n        \"min\": -656.1799541616258,\n        \"max\": 282.96223768578466,\n        \"num_unique_values\": 20,\n        \"samples\": [\n          -163.89595582190654,\n          173.87658135534002,\n          -656.1799541616258\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"Erro_Absoluto\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 148.39122511327747,\n        \"min\": 8.234913015664972,\n        \"max\": 656.1799541616258,\n        \"num_unique_values\": 20,\n        \"samples\": [\n          163.89595582190654,\n          173.87658135534002,\n          656.1799541616258\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"
            }
          },
          "metadata": {}
        },
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "\n",
            "RELATÓRIO EXCEL GERADO!\n"
          ]
        },
        {
          "output_type": "display_data",
          "data": {
            "text/plain": [
              "<IPython.core.display.Javascript object>"
            ],
            "application/javascript": [
              "\n",
              "    async function download(id, filename, size) {\n",
              "      if (!google.colab.kernel.accessAllowed) {\n",
              "        return;\n",
              "      }\n",
              "      const div = document.createElement('div');\n",
              "      const label = document.createElement('label');\n",
              "      label.textContent = `Downloading \"${filename}\": `;\n",
              "      div.appendChild(label);\n",
              "      const progress = document.createElement('progress');\n",
              "      progress.max = size;\n",
              "      div.appendChild(progress);\n",
              "      document.body.appendChild(div);\n",
              "\n",
              "      const buffers = [];\n",
              "      let downloaded = 0;\n",
              "\n",
              "      const channel = await google.colab.kernel.comms.open(id);\n",
              "      // Send a message to notify the kernel that we're ready.\n",
              "      channel.send({})\n",
              "\n",
              "      for await (const message of channel.messages) {\n",
              "        // Send a message to notify the kernel that we're ready.\n",
              "        channel.send({})\n",
              "        if (message.buffers) {\n",
              "          for (const buffer of message.buffers) {\n",
              "            buffers.push(buffer);\n",
              "            downloaded += buffer.byteLength;\n",
              "            progress.value = downloaded;\n",
              "          }\n",
              "        }\n",
              "      }\n",
              "      const blob = new Blob(buffers, {type: 'application/binary'});\n",
              "      const a = document.createElement('a');\n",
              "      a.href = window.URL.createObjectURL(blob);\n",
              "      a.download = filename;\n",
              "      div.appendChild(a);\n",
              "      a.click();\n",
              "      div.remove();\n",
              "    }\n",
              "  "
            ]
          },
          "metadata": {}
        },
        {
          "output_type": "display_data",
          "data": {
            "text/plain": [
              "<IPython.core.display.Javascript object>"
            ],
            "application/javascript": [
              "download(\"download_897c1591-3db0-4ea5-b61e-741120930932\", \"Resultado_Machine_Learning_Vendas.xlsx\", 271266)"
            ]
          },
          "metadata": {}
        },
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "\n",
            "====================================\n",
            "ANÁLISE FINALIZADA\n",
            "====================================\n",
            "Melhor algoritmo: Lasso\n",
            "RMSE no teste: 509.0842\n",
            "R² no teste: 0.6597\n",
            "\n",
            "O DATASET ORIGINAL FOI PRESERVADO.\n",
            "A seleção dos modelos foi realizada somente nos dados de desenvolvimento.\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "# ============================================================\n",
        "# MACHINE LEARNING - PREVISÃO DE VENDAS\n",
        "# TRATAMENTO DE INCONSISTÊNCIAS + PIPELINE\n",
        "#\n",
        "# MODELOS:\n",
        "# Linear, Lasso (L1), Ridge (L2), Elastic Net (L1+L2)\n",
        "#\n",
        "# TRATAMENTOS:\n",
        "# A - Exclusão de registros inconsistentes\n",
        "# B - Imputação pela mediana\n",
        "# C - Imputação pelo KNN\n",
        "#\n",
        "# VALIDAÇÃO: K-Fold com 5 divisões\n",
        "# TESTE FINAL: 20% dos registros\n",
        "#\n",
        "# O DATASET ORIGINAL NÃO SERÁ MODIFICADO.\n",
        "# ============================================================\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 1 - BIBLIOTECAS\n",
        "# ============================================================\n",
        "\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "from google.colab import drive, files\n",
        "from IPython.display import display\n",
        "\n",
        "from sklearn.base import BaseEstimator, TransformerMixin\n",
        "\n",
        "from sklearn.model_selection import (\n",
        "    train_test_split,\n",
        "    KFold,\n",
        "    GridSearchCV\n",
        ")\n",
        "\n",
        "from sklearn.pipeline import Pipeline\n",
        "from sklearn.compose import ColumnTransformer\n",
        "\n",
        "from sklearn.impute import (\n",
        "    SimpleImputer,\n",
        "    KNNImputer\n",
        ")\n",
        "\n",
        "from sklearn.preprocessing import (\n",
        "    StandardScaler,\n",
        "    OneHotEncoder\n",
        ")\n",
        "\n",
        "from sklearn.linear_model import (\n",
        "    LinearRegression,\n",
        "    Lasso,\n",
        "    Ridge,\n",
        "    ElasticNet\n",
        ")\n",
        "\n",
        "from sklearn.metrics import (\n",
        "    mean_absolute_error,\n",
        "    mean_squared_error,\n",
        "    r2_score\n",
        ")\n",
        "\n",
        "import warnings\n",
        "from sklearn.exceptions import ConvergenceWarning\n",
        "\n",
        "warnings.filterwarnings(\n",
        "    \"ignore\",\n",
        "    category=ConvergenceWarning\n",
        ")\n",
        "\n",
        "SEMENTE = 42\n",
        "\n",
        "print(\"Bibliotecas carregadas!\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 2 - CONECTAR GOOGLE DRIVE\n",
        "# ============================================================\n",
        "\n",
        "drive.mount(\"/content/drive\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 3 - CAMINHO DO ARQUIVO\n",
        "#\n",
        "# ATENÇÃO: ALTERE SOMENTE A LINHA ABAIXO!\n",
        "# ============================================================\n",
        "\n",
        "CAMINHO_ARQUIVO = \"/content/drive/MyDrive/Banco de Dados 1/Sales_transactions_2022_2025.xlsx\"\n",
        "\n",
        "# ============================================================\n",
        "# FIM DA PARTE QUE VOCÊ PRECISA ALTERAR\n",
        "# ============================================================\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 4 - LER O DATASET ORIGINAL\n",
        "# ============================================================\n",
        "\n",
        "df_original = pd.read_excel(CAMINHO_ARQUIVO)\n",
        "\n",
        "# Criar cópia independente.\n",
        "df = df_original.copy(deep=True)\n",
        "\n",
        "print(\"\\nDATASET CARREGADO\")\n",
        "print(\"Observações:\", len(df))\n",
        "print(\"Variáveis:\", len(df.columns))\n",
        "\n",
        "display(df.head())\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 5 - DEFINIR ALVO E PREDITORES\n",
        "# ============================================================\n",
        "\n",
        "ALVO = \"Sales_Amount\"\n",
        "\n",
        "NUMERICAS = [\n",
        "    \"Customer_Age\",\n",
        "    \"Unit_Price\",\n",
        "    \"Quantity\",\n",
        "    \"Discount_Percentage\",\n",
        "    \"Customer_Rating\"\n",
        "]\n",
        "\n",
        "CATEGORICAS = [\n",
        "    \"Customer_Segment\",\n",
        "    \"Sales_Channel\",\n",
        "    \"Product_Category\"\n",
        "]\n",
        "\n",
        "PREDITORES = NUMERICAS + CATEGORICAS\n",
        "\n",
        "colunas_necessarias = PREDITORES + [ALVO]\n",
        "\n",
        "faltantes = [\n",
        "    c for c in colunas_necessarias\n",
        "    if c not in df.columns\n",
        "]\n",
        "\n",
        "if faltantes:\n",
        "    raise ValueError(\n",
        "        f\"Colunas não encontradas: {faltantes}\"\n",
        "    )\n",
        "\n",
        "dados = df[colunas_necessarias].copy()\n",
        "\n",
        "# Converter variáveis numéricas.\n",
        "for coluna in NUMERICAS + [ALVO]:\n",
        "    dados[coluna] = pd.to_numeric(\n",
        "        dados[coluna],\n",
        "        errors=\"coerce\"\n",
        "    )\n",
        "\n",
        "# Padronizar a escrita das categorias.\n",
        "# Não estamos transformando categorias em números\n",
        "# ainda; isso será feito pelo One-Hot Encoding.\n",
        "\n",
        "for coluna in CATEGORICAS:\n",
        "    dados[coluna] = (\n",
        "        dados[coluna]\n",
        "        .astype(\"string\")\n",
        "        .str.strip()\n",
        "        .str.lower()\n",
        "        .replace(\"\", pd.NA)\n",
        "        .astype(object)\n",
        "    )\n",
        "\n",
        "dados[CATEGORICAS] = (\n",
        "    dados[CATEGORICAS]\n",
        "    .replace({pd.NA: np.nan})\n",
        ")\n",
        "\n",
        "# O alvo não pode ser imputado para regressão.\n",
        "# Removemos da cópia apenas alvos ausentes.\n",
        "dados = dados.dropna(subset=[ALVO]).copy()\n",
        "\n",
        "dados = dados[\n",
        "    np.isfinite(dados[ALVO])\n",
        "].copy()\n",
        "\n",
        "if len(dados) < 50:\n",
        "    raise ValueError(\n",
        "        \"Quantidade insuficiente de registros válidos.\"\n",
        "    )\n",
        "\n",
        "print(\"\\nDados preparados para análise.\")\n",
        "print(\"Observações com alvo válido:\", len(dados))\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 6 - REGRAS DE PLAUSIBILIDADE\n",
        "# ============================================================\n",
        "\n",
        "# Regras:\n",
        "#\n",
        "# Idade menor que 18: suspeita segundo a hipótese\n",
        "# de que Customer_Age representa comprador adulto.\n",
        "#\n",
        "# Idade de 112 anos: permanece válida inicialmente.\n",
        "#\n",
        "# Preço <= 0: incompatível com venda convencional.\n",
        "#\n",
        "# Quantidade <= 0: incompatível com venda efetiva.\n",
        "#\n",
        "# Desconto < 0 ou > 100: inválido.\n",
        "#\n",
        "# Avaliação fora de 1 a 5: inválida.\n",
        "#\n",
        "# As regras são hipóteses de trabalho,\n",
        "# não correções confirmadas pelos donos do dataset.\n",
        "\n",
        "def marcar_inconsistencias(X):\n",
        "\n",
        "    alertas = pd.DataFrame(\n",
        "        index=X.index\n",
        "    )\n",
        "\n",
        "    idade = pd.to_numeric(\n",
        "        X[\"Customer_Age\"],\n",
        "        errors=\"coerce\"\n",
        "    )\n",
        "\n",
        "    preco = pd.to_numeric(\n",
        "        X[\"Unit_Price\"],\n",
        "        errors=\"coerce\"\n",
        "    )\n",
        "\n",
        "    quantidade = pd.to_numeric(\n",
        "        X[\"Quantity\"],\n",
        "        errors=\"coerce\"\n",
        "    )\n",
        "\n",
        "    desconto = pd.to_numeric(\n",
        "        X[\"Discount_Percentage\"],\n",
        "        errors=\"coerce\"\n",
        "    )\n",
        "\n",
        "    avaliacao = pd.to_numeric(\n",
        "        X[\"Customer_Rating\"],\n",
        "        errors=\"coerce\"\n",
        "    )\n",
        "\n",
        "    alertas[\"Idade_invalida\"] = (\n",
        "        (idade < 18) | (idade > 120)\n",
        "    ).fillna(False)\n",
        "\n",
        "    alertas[\"Preco_invalido\"] = (\n",
        "        preco <= 0\n",
        "    ).fillna(False)\n",
        "\n",
        "    alertas[\"Quantidade_invalida\"] = (\n",
        "        (quantidade <= 0) |\n",
        "        (\n",
        "            quantidade.notna() &\n",
        "            (quantidade != np.floor(quantidade))\n",
        "        )\n",
        "    ).fillna(False)\n",
        "\n",
        "    alertas[\"Desconto_invalido\"] = (\n",
        "        (desconto < 0) |\n",
        "        (desconto > 100)\n",
        "    ).fillna(False)\n",
        "\n",
        "    alertas[\"Avaliacao_invalida\"] = (\n",
        "        (avaliacao < 1) |\n",
        "        (avaliacao > 5)\n",
        "    ).fillna(False)\n",
        "\n",
        "    alertas[\"Alguma_inconsistencia\"] = (\n",
        "        alertas.any(axis=1)\n",
        "    )\n",
        "\n",
        "    return alertas\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 7 - DIAGNÓSTICO DA QUALIDADE DOS DADOS\n",
        "# ============================================================\n",
        "\n",
        "X = dados[PREDITORES].copy()\n",
        "y = dados[ALVO].copy()\n",
        "\n",
        "alertas = marcar_inconsistencias(X)\n",
        "\n",
        "tabela_qualidade = pd.DataFrame({\n",
        "    \"Regra\": alertas.columns[:-1],\n",
        "    \"Ocorrencias\": (\n",
        "        alertas.iloc[:, :-1].sum().values\n",
        "    )\n",
        "})\n",
        "\n",
        "tabela_qualidade[\"Percentual (%)\"] = (\n",
        "    tabela_qualidade[\"Ocorrencias\"]\n",
        "    / len(X) * 100\n",
        ").round(4)\n",
        "\n",
        "print(\"\\nRELATÓRIO DE INCONSISTÊNCIAS\")\n",
        "display(tabela_qualidade)\n",
        "\n",
        "print(\n",
        "    \"Registros com pelo menos uma inconsistência:\",\n",
        "    int(alertas[\"Alguma_inconsistencia\"].sum())\n",
        ")\n",
        "\n",
        "print(\"\\nVALORES AUSENTES\")\n",
        "\n",
        "display(\n",
        "    X.isna().sum().to_frame(\n",
        "        \"Quantidade de ausentes\"\n",
        "    )\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 8 - DIVISÃO INICIAL EM TREINO E TESTE\n",
        "# ============================================================\n",
        "\n",
        "# O teste é separado antes da imputação\n",
        "# e antes da seleção dos hiperparâmetros.\n",
        "\n",
        "X_dev, X_teste_bruto, y_dev, y_teste_bruto = (\n",
        "    train_test_split(\n",
        "        X,\n",
        "        y,\n",
        "        test_size=0.20,\n",
        "        random_state=SEMENTE\n",
        "    )\n",
        ")\n",
        "\n",
        "print(\"\\nDIVISÃO INICIAL\")\n",
        "print(\"Desenvolvimento:\", len(X_dev))\n",
        "print(\"Teste reservado:\", len(X_teste_bruto))\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 9 - DEFINIR UM TESTE COMUM\n",
        "# ============================================================\n",
        "\n",
        "# Para comparar as estratégias de forma justa,\n",
        "# todas serão avaliadas nos mesmos registros.\n",
        "#\n",
        "# Utilizamos no teste apenas registros sem\n",
        "# inconsistências objetivas nos preditores.\n",
        "#\n",
        "# Valores originalmente ausentes continuam\n",
        "# presentes e serão tratados pelo pipeline.\n",
        "#\n",
        "# O teste não é utilizado para escolher a\n",
        "# mediana, os vizinhos ou os hiperparâmetros.\n",
        "\n",
        "alertas_teste = marcar_inconsistencias(\n",
        "    X_teste_bruto\n",
        ")\n",
        "\n",
        "mascara_teste = (\n",
        "    ~alertas_teste[\"Alguma_inconsistencia\"]\n",
        ")\n",
        "\n",
        "X_teste = X_teste_bruto.loc[\n",
        "    mascara_teste\n",
        "].copy()\n",
        "\n",
        "y_teste = y_teste_bruto.loc[\n",
        "    mascara_teste\n",
        "].copy()\n",
        "\n",
        "print(\"\\nCONJUNTO DE TESTE COMUM\")\n",
        "print(\"Registros:\", len(X_teste))\n",
        "\n",
        "print(\n",
        "    \"Registros incompatíveis retirados do teste:\",\n",
        "    int((~mascara_teste).sum())\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 10 - TRANSFORMADOR DE PLAUSIBILIDADE\n",
        "# ============================================================\n",
        "\n",
        "# Esta classe:\n",
        "#\n",
        "# 1. Recebe as variáveis numéricas.\n",
        "# 2. Identifica valores inválidos.\n",
        "# 3. Transforma os inválidos em NaN.\n",
        "# 4. Ajusta mediana ou KNN somente no treino.\n",
        "# 5. Imputa os valores.\n",
        "# 6. Ajusta idades e quantidades imputadas\n",
        "#    para valores inteiros plausíveis.\n",
        "#\n",
        "# Não usa Sales_Amount para fazer imputação.\n",
        "\n",
        "class TratamentoNumerico(\n",
        "    BaseEstimator,\n",
        "    TransformerMixin\n",
        "):\n",
        "\n",
        "    def __init__(\n",
        "        self,\n",
        "        metodo=\"mediana\",\n",
        "        n_vizinhos=5\n",
        "    ):\n",
        "        self.metodo = metodo\n",
        "        self.n_vizinhos = n_vizinhos\n",
        "\n",
        "    def _preparar(self, X):\n",
        "\n",
        "        arr = np.asarray(\n",
        "            X,\n",
        "            dtype=float\n",
        "        ).copy()\n",
        "\n",
        "        arr[~np.isfinite(arr)] = np.nan\n",
        "\n",
        "        # Ordem das colunas:\n",
        "        # 0 - Customer_Age\n",
        "        # 1 - Unit_Price\n",
        "        # 2 - Quantity\n",
        "        # 3 - Discount_Percentage\n",
        "        # 4 - Customer_Rating\n",
        "\n",
        "        idade = arr[:, 0]\n",
        "        preco = arr[:, 1]\n",
        "        quantidade = arr[:, 2]\n",
        "        desconto = arr[:, 3]\n",
        "        avaliacao = arr[:, 4]\n",
        "\n",
        "        idade[\n",
        "            (idade < 18) | (idade > 120)\n",
        "        ] = np.nan\n",
        "\n",
        "        preco[preco <= 0] = np.nan\n",
        "\n",
        "        quantidade[\n",
        "            (quantidade <= 0) |\n",
        "            (\n",
        "                np.isfinite(quantidade) &\n",
        "                (quantidade != np.floor(quantidade))\n",
        "            )\n",
        "        ] = np.nan\n",
        "\n",
        "        desconto[\n",
        "            (desconto < 0) | (desconto > 100)\n",
        "        ] = np.nan\n",
        "\n",
        "        avaliacao[\n",
        "            (avaliacao < 1) | (avaliacao > 5)\n",
        "        ] = np.nan\n",
        "\n",
        "        return arr\n",
        "\n",
        "    def fit(self, X, y=None):\n",
        "\n",
        "        arr = self._preparar(X)\n",
        "\n",
        "        if self.metodo == \"mediana\":\n",
        "\n",
        "            self.imputador_ = SimpleImputer(\n",
        "                strategy=\"median\"\n",
        "            )\n",
        "\n",
        "            self.imputador_.fit(arr)\n",
        "\n",
        "        elif self.metodo == \"knn\":\n",
        "\n",
        "            # Padronizar antes de calcular distâncias.\n",
        "            # Assim, preço não domina a distância\n",
        "            # apenas por apresentar valores maiores.\n",
        "\n",
        "            self.scaler_knn_ = StandardScaler()\n",
        "\n",
        "            arr_padronizado = (\n",
        "                self.scaler_knn_.fit_transform(arr)\n",
        "            )\n",
        "\n",
        "            self.imputador_ = KNNImputer(\n",
        "                n_neighbors=self.n_vizinhos,\n",
        "                weights=\"distance\"\n",
        "            )\n",
        "\n",
        "            self.imputador_.fit(\n",
        "                arr_padronizado\n",
        "            )\n",
        "\n",
        "        else:\n",
        "            raise ValueError(\n",
        "                \"Método inválido. Use mediana ou knn.\"\n",
        "            )\n",
        "\n",
        "        return self\n",
        "\n",
        "    def transform(self, X):\n",
        "\n",
        "        arr = self._preparar(X)\n",
        "\n",
        "        # Guardar posições originalmente ausentes\n",
        "        # ou consideradas inválidas.\n",
        "\n",
        "        mascara = np.isnan(arr)\n",
        "\n",
        "        if self.metodo == \"mediana\":\n",
        "\n",
        "            resultado = (\n",
        "                self.imputador_.transform(arr)\n",
        "            )\n",
        "\n",
        "        else:\n",
        "\n",
        "            arr_padronizado = (\n",
        "                self.scaler_knn_.transform(arr)\n",
        "            )\n",
        "\n",
        "            imputado_padronizado = (\n",
        "                self.imputador_.transform(\n",
        "                    arr_padronizado\n",
        "                )\n",
        "            )\n",
        "\n",
        "            resultado = (\n",
        "                self.scaler_knn_\n",
        "                .inverse_transform(\n",
        "                    imputado_padronizado\n",
        "                )\n",
        "            )\n",
        "\n",
        "        # Ajustar somente valores imputados.\n",
        "        # Valores válidos originais permanecem.\n",
        "\n",
        "        # Idade imputada: inteiro entre 18 e 120.\n",
        "        pos = mascara[:, 0]\n",
        "\n",
        "        resultado[pos, 0] = np.clip(\n",
        "            np.rint(resultado[pos, 0]),\n",
        "            18,\n",
        "            120\n",
        "        )\n",
        "\n",
        "        # Preço imputado: positivo.\n",
        "        pos = mascara[:, 1]\n",
        "\n",
        "        resultado[pos, 1] = np.maximum(\n",
        "            resultado[pos, 1],\n",
        "            0.01\n",
        "        )\n",
        "\n",
        "        # Quantidade imputada: inteiro >= 1.\n",
        "        pos = mascara[:, 2]\n",
        "\n",
        "        resultado[pos, 2] = np.maximum(\n",
        "            1,\n",
        "            np.rint(resultado[pos, 2])\n",
        "        )\n",
        "\n",
        "        # Desconto imputado: entre 0 e 100.\n",
        "        pos = mascara[:, 3]\n",
        "\n",
        "        resultado[pos, 3] = np.clip(\n",
        "            resultado[pos, 3],\n",
        "            0,\n",
        "            100\n",
        "        )\n",
        "\n",
        "        # Avaliação imputada: 1 a 5.\n",
        "        # Assumimos escala de notas inteiras.\n",
        "        pos = mascara[:, 4]\n",
        "\n",
        "        resultado[pos, 4] = np.clip(\n",
        "            np.rint(resultado[pos, 4]),\n",
        "            1,\n",
        "            5\n",
        "        )\n",
        "\n",
        "        return resultado\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 11 - CONSTRUIR O PIPELINE\n",
        "# ============================================================\n",
        "\n",
        "def criar_pipeline(metodo):\n",
        "\n",
        "    # Pré-processamento das variáveis numéricas.\n",
        "\n",
        "    numerico = Pipeline(\n",
        "        steps=[\n",
        "            (\n",
        "                \"tratamento\",\n",
        "                TratamentoNumerico(\n",
        "                    metodo=metodo,\n",
        "                    n_vizinhos=5\n",
        "                )\n",
        "            ),\n",
        "            (\n",
        "                \"padronizacao\",\n",
        "                StandardScaler()\n",
        "            )\n",
        "        ]\n",
        "    )\n",
        "\n",
        "    # Pré-processamento das categóricas.\n",
        "\n",
        "    categorico = Pipeline(\n",
        "        steps=[\n",
        "            (\n",
        "                \"imputacao\",\n",
        "                SimpleImputer(\n",
        "                    strategy=\"most_frequent\"\n",
        "                )\n",
        "            ),\n",
        "            (\n",
        "                \"onehot\",\n",
        "                OneHotEncoder(\n",
        "                    handle_unknown=\"ignore\"\n",
        "                )\n",
        "            )\n",
        "        ]\n",
        "    )\n",
        "\n",
        "    # Unir transformações.\n",
        "\n",
        "    preprocessamento = ColumnTransformer(\n",
        "        transformers=[\n",
        "            (\n",
        "                \"numericas\",\n",
        "                numerico,\n",
        "                NUMERICAS\n",
        "            ),\n",
        "            (\n",
        "                \"categoricas\",\n",
        "                categorico,\n",
        "                CATEGORICAS\n",
        "            )\n",
        "        ]\n",
        "    )\n",
        "\n",
        "    # Criar pipeline completo.\n",
        "\n",
        "    pipeline = Pipeline(\n",
        "        steps=[\n",
        "            (\n",
        "                \"preprocessamento\",\n",
        "                preprocessamento\n",
        "            ),\n",
        "            (\n",
        "                \"modelo\",\n",
        "                LinearRegression()\n",
        "            )\n",
        "        ]\n",
        "    )\n",
        "\n",
        "    return pipeline\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 12 - MODELOS E HIPERPARÂMETROS\n",
        "# ============================================================\n",
        "\n",
        "# Regressão Linear: sem regularização.\n",
        "#\n",
        "# Lasso: penalização L1.\n",
        "#\n",
        "# Ridge: penalização L2.\n",
        "#\n",
        "# Elastic Net: combinação L1 + L2.\n",
        "#\n",
        "# Alpha controla a intensidade da regularização.\n",
        "#\n",
        "# No Elastic Net, l1_ratio controla a proporção\n",
        "# da penalização L1 dentro da combinação.\n",
        "\n",
        "grade = [\n",
        "    {\n",
        "        \"modelo\": [\n",
        "            LinearRegression()\n",
        "        ]\n",
        "    },\n",
        "\n",
        "    {\n",
        "        \"modelo\": [\n",
        "            Lasso(\n",
        "                max_iter=50000,\n",
        "                random_state=SEMENTE\n",
        "            )\n",
        "        ],\n",
        "        \"modelo__alpha\": [\n",
        "            0.01,\n",
        "            0.1,\n",
        "            1.0\n",
        "        ]\n",
        "    },\n",
        "\n",
        "    {\n",
        "        \"modelo\": [\n",
        "            Ridge()\n",
        "        ],\n",
        "        \"modelo__alpha\": [\n",
        "            0.01,\n",
        "            1.0,\n",
        "            100.0\n",
        "        ]\n",
        "    },\n",
        "\n",
        "    {\n",
        "        \"modelo\": [\n",
        "            ElasticNet(\n",
        "                max_iter=50000,\n",
        "                random_state=SEMENTE\n",
        "            )\n",
        "        ],\n",
        "        \"modelo__alpha\": [\n",
        "            0.01,\n",
        "            0.1\n",
        "        ],\n",
        "        \"modelo__l1_ratio\": [\n",
        "            0.2,\n",
        "            0.5,\n",
        "            0.8\n",
        "        ]\n",
        "    }\n",
        "]\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 13 - VALIDAÇÃO CRUZADA\n",
        "# ============================================================\n",
        "\n",
        "validacao = KFold(\n",
        "    n_splits=5,\n",
        "    shuffle=True,\n",
        "    random_state=SEMENTE\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 14 - CONFIGURAR AS TRÊS ESTRATÉGIAS\n",
        "# ============================================================\n",
        "\n",
        "# A - Exclusão:\n",
        "# Retira registros inválidos do desenvolvimento.\n",
        "# Ausências comuns serão imputadas pela mediana.\n",
        "#\n",
        "# B - Mediana:\n",
        "# Mantém registros inválidos, transformando\n",
        "# valores incompatíveis em NaN.\n",
        "#\n",
        "# C - KNN:\n",
        "# Faz o mesmo, mas imputa usando vizinhos.\n",
        "\n",
        "estrategias = {\n",
        "    \"Exclusao\": \"mediana\",\n",
        "    \"Mediana\": \"mediana\",\n",
        "    \"KNN\": \"knn\"\n",
        "}\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 15 - EXECUTAR AS COMPARAÇÕES\n",
        "# ============================================================\n",
        "\n",
        "resultados_gerais = []\n",
        "resultados_configuracoes = []\n",
        "\n",
        "melhores_pipelines = {}\n",
        "\n",
        "for estrategia, metodo in estrategias.items():\n",
        "\n",
        "    print(\"\\n\" + \"=\" * 65)\n",
        "    print(\"ESTRATÉGIA:\", estrategia)\n",
        "    print(\"=\" * 65)\n",
        "\n",
        "    X_atual = X_dev.copy()\n",
        "    y_atual = y_dev.copy()\n",
        "\n",
        "    # Exclusão apenas na estratégia A.\n",
        "\n",
        "    if estrategia == \"Exclusao\":\n",
        "\n",
        "        alertas_dev = marcar_inconsistencias(\n",
        "            X_atual\n",
        "        )\n",
        "\n",
        "        mascara_valida = (\n",
        "            ~alertas_dev[\"Alguma_inconsistencia\"]\n",
        "        )\n",
        "\n",
        "        X_atual = X_atual.loc[\n",
        "            mascara_valida\n",
        "        ].copy()\n",
        "\n",
        "        y_atual = y_atual.loc[\n",
        "            mascara_valida\n",
        "        ].copy()\n",
        "\n",
        "    print(\n",
        "        \"Registros de desenvolvimento utilizados:\",\n",
        "        len(X_atual)\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        \"Registros retirados do desenvolvimento:\",\n",
        "        len(X_dev) - len(X_atual)\n",
        "    )\n",
        "\n",
        "    modelo_pipeline = criar_pipeline(\n",
        "        metodo\n",
        "    )\n",
        "\n",
        "    busca = GridSearchCV(\n",
        "        estimator=modelo_pipeline,\n",
        "        param_grid=grade,\n",
        "        scoring=\"neg_root_mean_squared_error\",\n",
        "        cv=validacao,\n",
        "        n_jobs=-1,\n",
        "        refit=True,\n",
        "        verbose=0,\n",
        "        error_score=\"raise\"\n",
        "    )\n",
        "\n",
        "    print(\"Executando GridSearchCV...\")\n",
        "    print(\"Aguarde. O KNN pode levar mais tempo.\")\n",
        "\n",
        "    busca.fit(\n",
        "        X_atual,\n",
        "        y_atual\n",
        "    )\n",
        "\n",
        "    melhor = busca.best_estimator_\n",
        "\n",
        "    melhores_pipelines[estrategia] = melhor\n",
        "\n",
        "    # Registrar todas as configurações testadas.\n",
        "\n",
        "    cv_df = pd.DataFrame(\n",
        "        busca.cv_results_\n",
        "    )\n",
        "\n",
        "    cv_df[\"Estrategia\"] = estrategia\n",
        "\n",
        "    cv_df[\"Algoritmo\"] = (\n",
        "        cv_df[\"param_modelo\"]\n",
        "        .apply(\n",
        "            lambda m: type(m).__name__\n",
        "        )\n",
        "    )\n",
        "\n",
        "    cv_df[\"RMSE_CV\"] = (\n",
        "        -cv_df[\"mean_test_score\"]\n",
        "    )\n",
        "\n",
        "    for _, linha in cv_df.iterrows():\n",
        "\n",
        "        resultados_configuracoes.append({\n",
        "            \"Estrategia\": estrategia,\n",
        "            \"Algoritmo\": linha[\"Algoritmo\"],\n",
        "            \"RMSE_CV\": linha[\"RMSE_CV\"],\n",
        "            \"Desvio_RMSE\": linha[\"std_test_score\"],\n",
        "            \"Parametros\": str(linha[\"params\"])\n",
        "        })\n",
        "\n",
        "    # Avaliar o melhor modelo da estratégia\n",
        "    # no conjunto de teste comum.\n",
        "\n",
        "    previsto = melhor.predict(\n",
        "        X_teste\n",
        "    )\n",
        "\n",
        "    mae = mean_absolute_error(\n",
        "        y_teste,\n",
        "        previsto\n",
        "    )\n",
        "\n",
        "    rmse = np.sqrt(\n",
        "        mean_squared_error(\n",
        "            y_teste,\n",
        "            previsto\n",
        "        )\n",
        "    )\n",
        "\n",
        "    r2 = r2_score(\n",
        "        y_teste,\n",
        "        previsto\n",
        "    )\n",
        "\n",
        "    resultados_gerais.append({\n",
        "        \"Estrategia\": estrategia,\n",
        "        \"Melhor_algoritmo\": type(\n",
        "            melhor.named_steps[\"modelo\"]\n",
        "        ).__name__,\n",
        "        \"N_treino\": len(X_atual),\n",
        "        \"RMSE_CV\": -busca.best_score_,\n",
        "        \"MAE_Teste\": mae,\n",
        "        \"RMSE_Teste\": rmse,\n",
        "        \"R2_Teste\": r2,\n",
        "        \"Melhores_parametros\": str(\n",
        "            busca.best_params_\n",
        "        )\n",
        "    })\n",
        "\n",
        "    print(\"\\nMelhor algoritmo:\",\n",
        "          type(\n",
        "              melhor.named_steps[\"modelo\"]\n",
        "          ).__name__)\n",
        "\n",
        "    print(\n",
        "        \"RMSE na validação:\",\n",
        "        round(-busca.best_score_, 4)\n",
        "    )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 16 - COMPARAÇÃO DOS QUATRO ALGORITMOS\n",
        "# EM CADA ESTRATÉGIA\n",
        "# ============================================================\n",
        "\n",
        "todas_configuracoes = pd.DataFrame(\n",
        "    resultados_configuracoes\n",
        ")\n",
        "\n",
        "# Escolher o melhor conjunto de hiperparâmetros\n",
        "# de cada algoritmo em cada estratégia.\n",
        "\n",
        "comparacao_algoritmos = (\n",
        "    todas_configuracoes\n",
        "    .sort_values(\"RMSE_CV\")\n",
        "    .drop_duplicates(\n",
        "        subset=[\n",
        "            \"Estrategia\",\n",
        "            \"Algoritmo\"\n",
        "        ]\n",
        "    )\n",
        "    .sort_values([\n",
        "        \"Estrategia\",\n",
        "        \"RMSE_CV\"\n",
        "    ])\n",
        "    .reset_index(drop=True)\n",
        ")\n",
        "\n",
        "print(\"\\nCOMPARAÇÃO DOS 4 ALGORITMOS\")\n",
        "print(\"DENTRO DE CADA ESTRATÉGIA:\")\n",
        "\n",
        "display(comparacao_algoritmos)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 17 - COMPARAÇÃO DAS TRÊS ESTRATÉGIAS\n",
        "# ============================================================\n",
        "\n",
        "resultado_final = pd.DataFrame(\n",
        "    resultados_gerais\n",
        ")\n",
        "\n",
        "# A escolha deve depender da validação cruzada.\n",
        "# Não utilizamos o RMSE do teste para selecionar.\n",
        "\n",
        "resultado_final = (\n",
        "    resultado_final\n",
        "    .sort_values(\"RMSE_CV\")\n",
        "    .reset_index(drop=True)\n",
        ")\n",
        "\n",
        "print(\"\\nRESULTADOS DAS TRÊS ESTRATÉGIAS:\")\n",
        "\n",
        "display(resultado_final)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 18 - IDENTIFICAR A ESTRATÉGIA VENCEDORA\n",
        "# ============================================================\n",
        "\n",
        "estrategia_vencedora = (\n",
        "    resultado_final.iloc[0][\"Estrategia\"]\n",
        ")\n",
        "\n",
        "modelo_vencedor = (\n",
        "    melhores_pipelines[estrategia_vencedora]\n",
        ")\n",
        "\n",
        "algoritmo_vencedor = type(\n",
        "    modelo_vencedor.named_steps[\"modelo\"]\n",
        ").__name__\n",
        "\n",
        "print(\"\\n\" + \"=\" * 65)\n",
        "print(\"RESULTADO DA SELEÇÃO\")\n",
        "print(\"=\" * 65)\n",
        "\n",
        "print(\n",
        "    \"Melhor estratégia:\",\n",
        "    estrategia_vencedora\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Melhor algoritmo:\",\n",
        "    algoritmo_vencedor\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"RMSE médio de validação:\",\n",
        "    round(\n",
        "        resultado_final.iloc[0][\"RMSE_CV\"],\n",
        "        4\n",
        "    )\n",
        ")\n",
        "\n",
        "print(\"\\nIMPORTANTE:\")\n",
        "print(\n",
        "    \"A seleção foi baseada na validação cruzada,\"\n",
        "    \" não no teste final.\"\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 19 - PREVISÕES DO MODELO VENCEDOR\n",
        "# ============================================================\n",
        "\n",
        "previsoes = modelo_vencedor.predict(\n",
        "    X_teste\n",
        ")\n",
        "\n",
        "erros = y_teste.to_numpy() - previsoes\n",
        "\n",
        "tabela_previsoes = X_teste.copy()\n",
        "\n",
        "tabela_previsoes[\"Venda_Real\"] = (\n",
        "    y_teste\n",
        ")\n",
        "\n",
        "tabela_previsoes[\"Venda_Prevista\"] = (\n",
        "    previsoes\n",
        ")\n",
        "\n",
        "tabela_previsoes[\"Residuo\"] = (\n",
        "    erros\n",
        ")\n",
        "\n",
        "tabela_previsoes[\"Erro_Absoluto\"] = (\n",
        "    np.abs(erros)\n",
        ")\n",
        "\n",
        "print(\"\\nPRIMEIRAS 20 PREVISÕES:\")\n",
        "\n",
        "display(\n",
        "    tabela_previsoes.head(20)\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 20 - GRÁFICO DA VALIDAÇÃO CRUZADA\n",
        "# ============================================================\n",
        "\n",
        "plt.figure(figsize=(10, 5))\n",
        "\n",
        "plt.bar(\n",
        "    resultado_final[\"Estrategia\"],\n",
        "    resultado_final[\"RMSE_CV\"]\n",
        ")\n",
        "\n",
        "plt.title(\n",
        "    \"Comparação das estratégias - RMSE na validação\"\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Estratégia de tratamento\")\n",
        "plt.ylabel(\"RMSE médio\")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 21 - GRÁFICO REAL VERSUS PREVISTO\n",
        "# ============================================================\n",
        "\n",
        "plt.figure(figsize=(8, 6))\n",
        "\n",
        "plt.scatter(\n",
        "    y_teste,\n",
        "    previsoes,\n",
        "    alpha=0.4\n",
        ")\n",
        "\n",
        "limite_min = min(\n",
        "    y_teste.min(),\n",
        "    previsoes.min()\n",
        ")\n",
        "\n",
        "limite_max = max(\n",
        "    y_teste.max(),\n",
        "    previsoes.max()\n",
        ")\n",
        "\n",
        "plt.plot(\n",
        "    [limite_min, limite_max],\n",
        "    [limite_min, limite_max],\n",
        "    \"r--\",\n",
        "    label=\"Previsão perfeita\"\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Valor real da venda\")\n",
        "plt.ylabel(\"Valor previsto\")\n",
        "\n",
        "plt.title(\n",
        "    \"Modelo selecionado: valores reais e previstos\"\n",
        ")\n",
        "\n",
        "plt.legend()\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 22 - ANÁLISE DOS RESÍDUOS\n",
        "# ============================================================\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(10, 5))\n",
        "\n",
        "ax.scatter(\n",
        "    previsoes,\n",
        "    erros,\n",
        "    alpha=0.4\n",
        ")\n",
        "\n",
        "ax.axhline(\n",
        "    0,\n",
        "    color=\"red\",\n",
        "    linestyle=\"--\"\n",
        ")\n",
        "\n",
        "ax.set_xlabel(\"Valores previstos\")\n",
        "ax.set_ylabel(\"Resíduos\")\n",
        "\n",
        "ax.set_title(\n",
        "    \"Diagnóstico dos resíduos\"\n",
        ")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "print(\"\\nDESCRIÇÃO DOS RESÍDUOS:\")\n",
        "\n",
        "display(\n",
        "    pd.Series(erros).describe()\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 23 - VERIFICAR A FÓRMULA COMERCIAL\n",
        "# ============================================================\n",
        "\n",
        "# Hipótese para transações convencionais:\n",
        "#\n",
        "# Valor de venda =\n",
        "# Preço * Quantidade * (1 - Desconto/100)\n",
        "#\n",
        "# A verificação é apenas diagnóstica.\n",
        "# Não será usada para escolher o modelo.\n",
        "\n",
        "formula = (\n",
        "    X_teste[\"Unit_Price\"]\n",
        "    * X_teste[\"Quantity\"]\n",
        "    * (\n",
        "        1 -\n",
        "        X_teste[\"Discount_Percentage\"] / 100\n",
        "    )\n",
        ")\n",
        "\n",
        "mascara_formula = (\n",
        "    formula.notna() &\n",
        "    np.isfinite(formula)\n",
        ")\n",
        "\n",
        "if mascara_formula.any():\n",
        "\n",
        "    mae_formula = mean_absolute_error(\n",
        "        y_teste.loc[mascara_formula],\n",
        "        formula.loc[mascara_formula]\n",
        "    )\n",
        "\n",
        "    print(\"\\nDIAGNÓSTICO DA FÓRMULA COMERCIAL\")\n",
        "\n",
        "    print(\n",
        "        \"MAE da fórmula:\",\n",
        "        round(mae_formula, 4)\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        \"Observações verificadas:\",\n",
        "        int(mascara_formula.sum())\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        \"A fórmula pressupõe que não existam\"\n",
        "        \" fretes, tributos ou outros ajustes.\"\n",
        "    )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 24 - EXPORTAR RELATÓRIO PARA EXCEL\n",
        "# ============================================================\n",
        "\n",
        "arquivo_saida = (\n",
        "    \"Comparacao_Regressoes_Tratamentos.xlsx\"\n",
        ")\n",
        "\n",
        "# Registrar o número de casos afetados\n",
        "# no conjunto de desenvolvimento.\n",
        "\n",
        "registro_exclusoes = (\n",
        "    marcar_inconsistencias(X_dev)\n",
        "    .sum()\n",
        "    .reset_index()\n",
        ")\n",
        "\n",
        "registro_exclusoes.columns = [\n",
        "    \"Regra\",\n",
        "    \"Ocorrencias_desenvolvimento\"\n",
        "]\n",
        "\n",
        "with pd.ExcelWriter(\n",
        "    arquivo_saida,\n",
        "    engine=\"openpyxl\"\n",
        ") as writer:\n",
        "\n",
        "    tabela_qualidade.to_excel(\n",
        "        writer,\n",
        "        sheet_name=\"Qualidade_Dados\",\n",
        "        index=False\n",
        "    )\n",
        "\n",
        "    registro_exclusoes.to_excel(\n",
        "        writer,\n",
        "        sheet_name=\"Exclusoes_Potenciais\",\n",
        "        index=False\n",
        "    )\n",
        "\n",
        "    comparacao_algoritmos.to_excel(\n",
        "        writer,\n",
        "        sheet_name=\"Modelos_Validacao\",\n",
        "        index=False\n",
        "    )\n",
        "\n",
        "    resultado_final.to_excel(\n",
        "        writer,\n",
        "        sheet_name=\"Estrategias\",\n",
        "        index=False\n",
        "    )\n",
        "\n",
        "    tabela_previsoes.to_excel(\n",
        "        writer,\n",
        "        sheet_name=\"Previsoes_Teste\",\n",
        "        index=False\n",
        "    )\n",
        "\n",
        "print(\"\\nRELATÓRIO GERADO:\", arquivo_saida)\n",
        "\n",
        "files.download(arquivo_saida)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ETAPA 25 - CONCLUSÃO\n",
        "# ============================================================\n",
        "\n",
        "print(\"\\n\" + \"=\" * 65)\n",
        "print(\"PROCESSAMENTO FINALIZADO\")\n",
        "print(\"=\" * 65)\n",
        "\n",
        "print(\n",
        "    \"Estratégia selecionada:\",\n",
        "    estrategia_vencedora\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Algoritmo selecionado:\",\n",
        "    algoritmo_vencedor\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"O arquivo original do Kaggle\"\n",
        "    \" não foi alterado.\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Todos os parâmetros aprendidos foram\"\n",
        "    \" ajustados usando dados de desenvolvimento.\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"O conjunto de teste foi utilizado\"\n",
        "    \" somente para avaliação.\"\n",
        ")\n",
        "\n"
      ],
