            "application/vnd.google.colaboratory.intrinsic+json": {
              "type": "dataframe",
              "variable_name": "tabela_devolucao",
              "summary": "{\n  \"name\": \"tabela_devolucao\",\n  \"rows\": 3,\n  \"fields\": [\n    {\n      \"column\": \"Return_Flag\",\n      \"properties\": {\n        \"dtype\": \"string\",\n        \"num_unique_values\": 3,\n        \"samples\": [\n          \"No\",\n          \"Yes\",\n          \"All\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"Motivo ausente\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 9334,\n        \"min\": 0,\n        \"max\": 16168,\n        \"num_unique_values\": 2,\n        \"samples\": [\n          0,\n          16168\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"Motivo informado\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 1083,\n        \"min\": 0,\n        \"max\": 1877,\n        \"num_unique_values\": 2,\n        \"samples\": [\n          1877,\n          0\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"All\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 8842,\n        \"min\": 1877,\n        \"max\": 18045,\n        \"num_unique_values\": 3,\n        \"samples\": [\n          16168,\n          1877\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"
